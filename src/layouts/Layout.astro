---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Payyavoor Crushers | Granite mining and aggregate supply</title>
		<meta name="description" content="Payyavoor Crushers is a trusted name in granite mining and aggregate production since 1995. Supplying high-quality materials for roads, bridges, and infrastructure." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600;1,700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-brandBg text-gray-900 font-satoshi antialiased overflow-x-hidden">

		<!-- ░░ INTRO OVERLAY — full-screen, contains the live text ░░ -->
		<div id="intro-overlay">
		  <div class="intro-glow"></div>
		  <div class="intro-center">
			<h2 id="intro-heading" class="intro-h1">
			  Built on
			  <span class="fn-container">
				<span id="overlay-fn-inner" class="fn-inner">
				  <span class="fn-word font-bold text-brandBlue">Strength.</span>
				  <span class="fn-word fn-word--italic font-bold text-brandBlue">Strength.</span>
				</span>
			  </span><br />
			  Driven by <span class="font-bold text-[#1A9487]">Quality.</span>
			</h2>
		  </div>
		</div>

		<slot />

		<!-- Floating WhatsApp Button -->
		<a 
		  href="https://wa.me/918281620000" 
		  target="_blank" 
		  rel="noopener noreferrer" 
		  class="whatsapp-float"
		  aria-label="Chat on WhatsApp"
		>
		  <svg viewBox="0 0 24 24" class="w-8 h-8 fill-current">
		    <path d="M12.012 2C6.48 2 2 6.48 2 12.012c0 1.764.462 3.486 1.338 5.01L2 22l5.124-1.338a9.907 9.907 0 0 0 4.888 1.35h.004c5.532 0 10.012-4.48 10.012-10.012C22.028 6.48 17.544 2 12.012 2zm0 18.36c-1.494 0-2.964-.4-4.248-1.164l-.306-.18-3.15.822.84-3.072-.2-.318a8.318 8.318 0 0 1-1.272-4.44c0-4.596 3.744-8.34 8.34-8.34 2.226 0 4.314.87 5.892 2.448a8.277 8.277 0 0 1 2.448 5.892c0 4.596-3.744 8.34-8.34 8.34zm4.578-6.246c-.252-.126-1.488-.732-1.722-.816-.234-.084-.402-.126-.57.126-.174.252-.666.834-.816 1.002-.15.174-.3.192-.552.066a7.012 7.012 0 0 1-2.034-1.254 7.747 7.747 0 0 1-1.41-1.758c-.15-.252-.018-.39.108-.516.114-.114.252-.294.378-.444.126-.15.168-.252.252-.42.084-.174.042-.324-.024-.45-.066-.126-.57-1.374-.78-1.878-.204-.492-.414-.426-.57-.432-.144-.006-.312-.006-.48-.006-.168 0-.444.066-.678.318-.234.252-.894.876-.894 2.136 0 1.26.918 2.478 1.044 2.646.126.168 1.8 2.748 4.356 3.852.606.264 1.08.42 1.452.54.612.192 1.17.168 1.614.102.492-.072 1.488-.606 1.698-1.194.21-.588.21-1.092.15-1.194-.066-.108-.234-.174-.486-.3z"/>
		  </svg>
		</a>
	</body>
</html>

<style is:global>

  /* ── Intro overlay ─────────────────────────────────── */
  #intro-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 9000;
    background-color: #212A31;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: background-color 1s cubic-bezier(0.25, 1, 0.5, 1);
    overflow: hidden;
  }
  
  .intro-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80vw;
    height: 80vw;
    max-width: 1000px;
    max-height: 1000px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 70%);
    filter: blur(50px);
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    transition: opacity 1s cubic-bezier(0.25, 1, 0.5, 1);
  }

  #intro-overlay.color-shift {
    background-color: #fefdf7;
  }
  
  #intro-overlay.color-shift .intro-glow {
    opacity: 0;
  }

  /* Hero section sits ABOVE the overlay so carousel/text are visible */
  #hero {
    position: relative;
    z-index: 10000;
  }

  /* Centered container matches hero container padding */
  .intro-center {
    width: 100%;
    padding: 0 1.5rem;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .intro-h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.1rem; /* matches text-[2.1rem] */
    line-height: 1.35;
    font-weight: 400;
    color: #fefdf7;
    margin: 0;
    display: inline-block; /* needed for transform-origin */
    opacity: 0;
    transform: scale(0.94) translateY(18px);
    /* entry animation properties */
    transition: opacity 1.7s cubic-bezier(0.25, 1, 0.5, 1),
                transform 1.7s cubic-bezier(0.25, 1, 0.5, 1),
                color 1.7s cubic-bezier(0.25, 1, 0.5, 1);
  }
  @media (min-width: 768px) {
    .intro-h1 {
      font-size: 3.75rem; /* text-6xl = 60px */
      line-height: 1.2;
    }
  }
  @media (min-width: 1024px) {
    .intro-h1 {
      font-size: 5rem; /* lg:text-[5rem] = 80px */
    }
  }
  .intro-h1.entered {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* ── Foundation word flip ──────────────────────────── */
  .fn-container {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    height: 1.1em;
  }
  .fn-inner {
    display: block;
    transition: transform 0.55s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .fn-word {
    display: block;
    line-height: 1.1;
    font-weight: 300;
  }
  .fn-word--italic { font-style: italic; }
  .fn-inner.flipped { transform: translateY(-50%); }

  /* ── Real hero h1 — hidden until overlay departs ────── */
  #hero-real-h1 {
    opacity: 0;
  }

  /* ── Hero text block — no translateY (overlay does the move) */
  #hero-text-block {
    /* intentionally no transform */
  }

  /* ── Subtitle — hidden during intro ───────────────── */
  #hero-subtitle {
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1);
  }
  #hero-subtitle.intro-revealed { opacity: 1; }

  /* ── Carousel — rises from below simultaneously ────── */
  #hero-carousel {
    opacity: 0;
    transform: translateY(44px);
    transition: opacity 0.85s cubic-bezier(0.25, 1, 0.5, 1),
                transform 0.85s cubic-bezier(0.25, 1, 0.5, 1);
  }
  #hero-carousel.intro-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Copyright text — hidden during intro ──────────── */
  #hero-copyright {
    opacity: 0;
    transition: opacity 0.85s cubic-bezier(0.25, 1, 0.5, 1);
  }
  #hero-copyright.intro-revealed { opacity: 1; }

  /* ── Navbar wrapper fades in above the overlay ────── */
  #navbar-wrapper {
    z-index: 10001; /* above overlay z-9000 */
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1);
  }
  #navbar-wrapper.intro-revealed { opacity: 1; }

  /* ── Scroll-triggered reveals (all other sections) ─── */
  .reveal-text {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s cubic-bezier(0.25, 1, 0.5, 1),
                transform 1s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .reveal-text.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Floating WhatsApp Button ────────────────────── */
  .whatsapp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 60px;
    height: 60px;
    background-color: #25D366;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.3), 0 8px 32px rgba(0, 0, 0, 0.15);
    z-index: 99999;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.3s ease;
  }

  .whatsapp-float:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4), 0 12px 40px rgba(0, 0, 0, 0.2);
  }

  .whatsapp-float:active {
    transform: scale(0.95);
  }

  /* Subtle pulsing effect around the button */
  .whatsapp-float::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: #25D366;
    opacity: 0.35;
    z-index: -1;
    animation: whatsapp-pulse 2s infinite ease-out;
  }

  @keyframes whatsapp-pulse {
    0% {
      transform: scale(1);
      opacity: 0.35;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {

    /* ── Elements ─────────────────────────────────────── */
    const overlay        = document.getElementById('intro-overlay') as HTMLElement;
    const introHeading   = document.getElementById('intro-heading') as HTMLElement;
    const overlayFnInner = document.getElementById('overlay-fn-inner') as HTMLElement;
    const heroRealH1     = document.getElementById('hero-real-h1') as HTMLElement;
    const heroSubtitle   = document.getElementById('hero-subtitle') as HTMLElement;
    const heroCarousel   = document.getElementById('hero-carousel') as HTMLElement;
    const heroCopyright  = document.getElementById('hero-copyright') as HTMLElement;
    const navbarWrapper  = document.getElementById('navbar-wrapper') as HTMLElement;

    /* Prevent browser scroll restoration */
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
    document.body.style.overflow = 'hidden';

    /* ── Step 0: Zoom-in entry of overlay text ────────── */
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        introHeading?.classList.add('entered');
      });
    });

    /* ── Step 1 (700ms): flip "foundation" italic ─────── */
    setTimeout(() => {
      overlayFnInner?.classList.add('flipped');
    }, 700);

    /* ── Step 2 (1400ms): bg shift + text glides to hero position ── */
    setTimeout(() => {

      /* Calculate exact delta from overlay heading → real h1 */
      const fromRect = introHeading?.getBoundingClientRect();
      const toRect   = heroRealH1?.getBoundingClientRect();

      if (introHeading && fromRect && toRect) {
        const dy = toRect.top  - fromRect.top;
        const dx = toRect.left - fromRect.left;

        /* Override transition for the position glide */
        introHeading.style.transition = [
          'transform 1.3s cubic-bezier(0.25, 1, 0.5, 1)',
          'opacity   1.3s cubic-bezier(0.25, 1, 0.5, 1)',
          'color     1.3s cubic-bezier(0.25, 1, 0.5, 1)'
        ].join(', ');

        /* Fly overlay heading to real h1 position */
        introHeading.style.transform = `translate(${dx}px, ${dy}px) scale(1)`;
        introHeading.style.color     = '#000000';
      }

      /* bg color shift fires simultaneously */
      overlay?.classList.add('color-shift');

      /* Reveal everything else */
      heroSubtitle?.classList.add('intro-revealed');
      heroCarousel?.classList.add('intro-revealed');
      heroCopyright?.classList.add('intro-revealed');
      navbarWrapper?.classList.add('intro-revealed');

      document.body.style.overflow = '';

    }, 1400);

    /* ── Step 3 (2400ms): snap real h1, remove overlay ── */
    setTimeout(() => {
      /* Make real h1 visible instantly (overlay still on top) */
      if (heroRealH1) heroRealH1.style.opacity = '1';
      /* Remove overlay — real h1 is now the visible text */
      overlay?.remove();
    }, 2800);

    /* ── Scroll-triggered reveals (non-hero) ──────────── */
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
        } else {
          entry.target.classList.remove('revealed');
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -5% 0px' });

    document.querySelectorAll('.reveal-text').forEach((el) => observer.observe(el));
  });
</script>
