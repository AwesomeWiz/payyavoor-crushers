---
---

<section id="technology" class="w-full py-16 px-6 md:px-12 bg-transparent overflow-hidden reveal-text">
  <div class="max-w-7xl mx-auto rounded-[2rem] md:rounded-[2.5rem] bg-gradient-to-br from-[#000428] via-[#00285e] to-[#004e92] border border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-6 md:p-14 relative overflow-hidden">
    
    <!-- Outer overflow container for slides -->
    <div class="overflow-hidden w-full relative z-10">
      <div class="slides-wrapper flex w-[200%] transition-transform duration-600 ease-out">
        
        <!-- SLIDE 1: Metso Video Player & Content -->
        <div class="metso-slide w-1/2 flex flex-col lg:flex-row items-center gap-10 lg:gap-16 px-1 shrink-0">
          
          <!-- Media Column (Left) -->
          <div class="w-full lg:w-[45%] flex items-center justify-center relative py-6">
            <div id="video-wrapper" class="video-wrapper w-full max-w-[440px] h-[280px] md:h-[320px] rounded-3xl overflow-hidden shadow-lg border border-white/60 relative cursor-pointer group">
              <video 
                id="metso-video"
                src="/video/metso.mp4" 
                autoplay 
                loop 
                muted 
                playsinline 
                class="w-full h-full object-cover rounded-3xl"
              ></video>

              <!-- Play/Pause overlay -->
              <div id="video-overlay" class="video-overlay">
                <div id="video-play-btn" class="video-play-btn">
                  <svg id="icon-pause" class="video-icon" viewBox="0 0 24 24" fill="white">
                    <rect x="6" y="4" width="4" height="16" rx="1"/>
                    <rect x="14" y="4" width="4" height="16" rx="1"/>
                  </svg>
                  <svg id="icon-play" class="video-icon hidden" viewBox="0 0 24 24" fill="white">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>

              <!-- Mute toggle -->
              <button id="mute-toggle" class="mute-toggle" aria-label="Toggle sound">
                <svg id="icon-muted" class="w-4 h-4" viewBox="0 0 24 24" fill="white">
                  <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                </svg>
                <svg id="icon-unmuted" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="white">
                  <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                </svg>
              </button>

              <!-- Progress bar -->
              <div class="video-progress-track">
                <div id="video-progress" class="video-progress-bar"></div>
              </div>

              <!-- Ripple container -->
              <div id="video-ripple" class="video-ripple-container"></div>
            </div>

            <!-- Floating badges -->
            <div class="absolute -top-1 -left-1 md:left-2 bg-white text-gray-900 font-bold px-4 py-2 rounded-2xl text-xs md:text-sm shadow-lg border border-blue-50 z-20 font-satoshi tracking-tight select-none">
              Finnish Engineering
            </div>
            <div class="absolute -bottom-1 -right-1 md:right-2 bg-white text-gray-900 font-bold px-4 py-2 rounded-2xl text-xs md:text-sm shadow-lg border border-blue-50 z-20 font-satoshi tracking-tight select-none">
              Nordberg® HP200™
            </div>
          </div>

          <!-- Text Column (Right) -->
          <div class="w-full lg:w-[55%] flex flex-col justify-center text-left">
            <span class="inline-block text-[11px] md:text-xs font-bold text-sky-300 tracking-[0.25em] uppercase mb-4 font-satoshi">
              Finnish Excellence
            </span>
            <h3 class="text-3xl md:text-5xl font-semibold mb-6 text-white leading-tight" style="font-family: 'Montserrat', sans-serif;">
              Advanced Machinery, <br class="hidden lg:block"/>
              <span class="text-sky-400">High Performance</span>
            </h3>
            <p class="text-white/80 font-satoshi text-[15px] md:text-lg leading-relaxed mb-8 max-w-xl">
              At Payyavoor Crushers, excellence begins with the use of advanced Finnish-engineered Metso machinery, renowned worldwide for precision, innovation, and reliability. This technology enables us to produce premium aggregates with unmatched consistency and shape.
            </p>
            <a href="#about" class="inline-flex items-center gap-3 bg-brandBlue text-white font-bold px-6 py-3.5 rounded-full text-xs md:text-sm hover:bg-[#005a8d] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 w-fit shadow-md hover:shadow-lg">
              Learn More
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

        </div>

        <!-- SLIDE 2: Metso Brand Card & Content -->
        <div class="metso-slide w-1/2 flex flex-col lg:flex-row items-center gap-10 lg:gap-16 px-1 shrink-0">
          
          <!-- Media Column (Left) -->
          <div class="w-full lg:w-[45%] flex items-center justify-center relative py-6">
            <div id="tilt-card" class="tilt-card bg-white p-6 md:p-10 rounded-3xl shadow-lg w-full max-w-[440px] h-[280px] md:h-[320px] flex items-center justify-center border border-white/60 relative overflow-hidden cursor-pointer">
              <div class="tilt-glare"></div>
              <img 
                src="/images/metsologo.jpg" 
                alt="Metso Finnish Technology" 
                class="w-full h-full object-contain filter contrast-125 relative z-10 pointer-events-none select-none"
              />
            </div>

            <!-- Floating badges -->
            <div class="absolute -top-1 -left-1 md:left-2 bg-white text-gray-900 font-bold px-4 py-2 rounded-2xl text-xs md:text-sm shadow-lg border border-blue-50 z-20 font-satoshi tracking-tight select-none">
              Precision Crushing
            </div>
            <div class="absolute -bottom-1 -right-1 md:right-2 bg-white text-gray-900 font-bold px-4 py-2 rounded-2xl text-xs md:text-sm shadow-lg border border-blue-50 z-20 font-satoshi tracking-tight select-none">
              Consistent Quality
            </div>
          </div>

          <!-- Text Column (Right) -->
          <div class="w-full lg:w-[55%] flex flex-col justify-center text-left">
            <span class="inline-block text-[11px] md:text-xs font-bold text-sky-300 tracking-[0.25em] uppercase mb-4 font-satoshi">
              Nordic Standards
            </span>
            <h3 class="text-3xl md:text-5xl font-semibold mb-6 text-white leading-tight" style="font-family: 'Montserrat', sans-serif;">
              Superior Cubicity, <br class="hidden lg:block"/>
              <span class="text-sky-400">Built to Last</span>
            </h3>
            <p class="text-white/80 font-satoshi text-[15px] md:text-lg leading-relaxed mb-8 max-w-xl">
              By combining world-class Finnish engineering with rigorous quality control, we ensure every aggregate meets the highest standards of durability. Our processing guarantees superior particle shape, optimizing structural strength for your construction.
            </p>
            <a href="#products" class="inline-flex items-center gap-3 bg-brandBlue text-white font-bold px-6 py-3.5 rounded-full text-xs md:text-sm hover:bg-[#005a8d] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 w-fit shadow-md hover:shadow-lg">
              View Products
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

        </div>

      </div>
    </div>

    <!-- Dot Indicators at the bottom -->
    <div class="flex items-center justify-center gap-3 mt-8 md:mt-10 select-none relative z-20">
      <button class="metso-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300 active" data-index="0" aria-label="Slide 1"></button>
      <button class="metso-dot w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300" data-index="1" aria-label="Slide 2"></button>
    </div>

  </div>
</section>

<style>
  /* ── 3D Tilt Card ─────────────────────────── */
  .tilt-card {
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out, box-shadow 0.4s ease;
    will-change: transform;
  }
  .tilt-card:hover {
    box-shadow: 
      0 25px 60px -12px rgba(0, 90, 141, 0.15),
      0 0 0 1px rgba(0, 90, 141, 0.05);
  }

  /* Moving glare */
  .tilt-glare {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      600px circle at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.35) 0%,
      rgba(255, 255, 255, 0.1) 30%,
      transparent 70%
    );
    border-radius: inherit;
  }
  .tilt-card:hover .tilt-glare {
    opacity: 1;
  }

  /* ── Interactive Video ────────────────────── */
  .video-wrapper {
    position: relative;
    transition: all 0.5s ease;
  }
  .video-wrapper:hover {
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.25);
    transform: translateY(-2px);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(circle, rgba(0,0,0,0.25) 0%, transparent 70%);
  }
  .video-wrapper:hover .video-overlay {
    opacity: 1;
  }

  .video-play-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 2px solid rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    transform: scale(0.85);
  }
  .video-wrapper:hover .video-play-btn {
    transform: scale(1);
  }
  .video-play-btn:active {
    transform: scale(0.9) !important;
  }

  .video-icon {
    width: 22px;
    height: 22px;
  }
  .video-icon.hidden {
    display: none;
  }

  /* Mute button */
  .mute-toggle {
    position: absolute;
    bottom: 16px;
    right: 12px;
    z-index: 15;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: all 0.3s ease;
    transform: translateY(4px);
  }
  .video-wrapper:hover .mute-toggle {
    opacity: 1;
    transform: translateY(0);
  }
  .mute-toggle:hover {
    background: rgba(0, 0, 0, 0.7);
    border-color: rgba(255, 255, 255, 0.4);
    transform: scale(1.1) !important;
  }
  .mute-toggle .hidden {
    display: none;
  }

  /* Progress bar */
  .video-progress-track {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.2);
    z-index: 15;
    opacity: 0;
    transition: opacity 0.3s ease, height 0.2s ease;
  }
  .video-wrapper:hover .video-progress-track {
    opacity: 1;
    height: 4px;
  }
  .video-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #007eb5, #1A9487);
    border-radius: 0 2px 2px 0;
    transition: width 0.1s linear;
  }

  /* Click ripple effect */
  .video-ripple-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 20;
    overflow: hidden;
    border-radius: inherit;
  }
  .video-ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    transform: scale(0);
    animation: ripple-expand 0.6s ease-out forwards;
    pointer-events: none;
  }
  @keyframes ripple-expand {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

  /* Flash on play/pause */
  @keyframes flash {
    0% { opacity: 1; }
    100% { opacity: 0; }
  }
  .video-flash {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.12);
    z-index: 5;
    pointer-events: none;
    animation: flash 0.4s ease-out forwards;
    border-radius: inherit;
  }

  /* Carousel Dots */
  .metso-dot.active {
    background-color: #ffffff;
    transform: scale(1.25);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {

    /* ═══════════════════════════════════════════
       CAROUSEL / SLIDER LOGIC
       ═══════════════════════════════════════════ */
    const dots = document.querySelectorAll('.metso-dot');
    const wrapper = document.querySelector('.slides-wrapper') as HTMLElement;

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0', 10);
        
        // Update dots state
        dots.forEach(d => d.classList.remove('active'));
        dot.classList.add('active');

        // Translate wrapper (since wrapper is 200% wide, slide 0 -> 0%, slide 1 -> -50%)
        if (wrapper) {
          wrapper.style.transform = `translateX(-${index * 50}%)`;
        }
      });
    });

    /* ═══════════════════════════════════════════
       3D TILT CARD
       ═══════════════════════════════════════════ */
    const card = document.getElementById('tilt-card') as HTMLElement;
    const glare = card?.querySelector('.tilt-glare') as HTMLElement;

    if (card) {
      const maxTilt = 18;    // degrees
      const perspective = 800; // px

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        // Normalised -1 → 1
        const normX = (x - centerX) / centerX;
        const normY = (y - centerY) / centerY;

        const rotateY = normX * maxTilt;
        const rotateX = -normY * maxTilt;

        card.style.transform = `perspective(${perspective}px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.03, 1.03, 1.03)`;

        // Move glare with cursor
        if (glare) {
          const glareX = ((x / rect.width) * 100).toFixed(1);
          const glareY = ((y / rect.height) * 100).toFixed(1);
          glare.style.setProperty('--glare-x', `${glareX}%`);
          glare.style.setProperty('--glare-y', `${glareY}%`);
        }
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        card.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease';
      });

      card.addEventListener('mouseenter', () => {
        card.style.transition = 'transform 0.1s ease-out, box-shadow 0.4s ease';
      });
    }

    /* ═══════════════════════════════════════════
       INTERACTIVE VIDEO PLAYER
       ═══════════════════════════════════════════ */
    const video = document.getElementById('metso-video') as HTMLVideoElement;
    const videoWrapper = document.getElementById('video-wrapper') as HTMLElement;
    const iconPause = document.getElementById('icon-pause') as HTMLElement;
    const iconPlay = document.getElementById('icon-play') as HTMLElement;
    const muteBtn = document.getElementById('mute-toggle') as HTMLElement;
    const iconMuted = document.getElementById('icon-muted') as HTMLElement;
    const iconUnmuted = document.getElementById('icon-unmuted') as HTMLElement;
    const progressBar = document.getElementById('video-progress') as HTMLElement;
    const rippleContainer = document.getElementById('video-ripple') as HTMLElement;

    if (video && videoWrapper) {

      // Play / Pause on click
      videoWrapper.addEventListener('click', (e) => {
        // Don't toggle if clicking mute button
        if ((e.target as HTMLElement).closest('#mute-toggle')) return;

        if (video.paused) {
          video.play();
          iconPause.classList.remove('hidden');
          iconPlay.classList.add('hidden');
        } else {
          video.pause();
          iconPause.classList.add('hidden');
          iconPlay.classList.remove('hidden');
        }

        // Ripple at click position
        const rect = videoWrapper.getBoundingClientRect();
        const ripple = document.createElement('div');
        ripple.className = 'video-ripple';
        const size = Math.max(rect.width, rect.height);
        ripple.style.width = ripple.style.height = `${size}px`;
        ripple.style.left = `${e.clientX - rect.left - size / 2}px`;
        ripple.style.top = `${e.clientY - rect.top - size / 2}px`;
        rippleContainer.appendChild(ripple);
        setTimeout(() => ripple.remove(), 600);

        // Flash
        const flash = document.createElement('div');
        flash.className = 'video-flash';
        videoWrapper.appendChild(flash);
        setTimeout(() => flash.remove(), 400);
      });

      // Mute / Unmute
      muteBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        video.muted = !video.muted;
        if (video.muted) {
          iconMuted.classList.remove('hidden');
          iconUnmuted.classList.add('hidden');
        } else {
          iconMuted.classList.add('hidden');
          iconUnmuted.classList.remove('hidden');
        }
      });

      // Progress bar
      video.addEventListener('timeupdate', () => {
        if (video.duration) {
          const pct = (video.currentTime / video.duration) * 100;
          progressBar.style.width = `${pct}%`;
        }
      });
    }

  });
</script>
