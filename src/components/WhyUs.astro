---
const cards = [
  { num: "01", title: "Proven Expertise", desc: "With decades of experience since 1995, we bring deep industry knowledge and a track record of delivering materials for major infrastructure projects.", bgClass: "bg-[#8dbcb6]", textClass: "text-gray-900", img: "/images/abstract1.png" },
  { num: "02", title: "Consistent Quality", desc: "Our aggregates are processed with precision to ensure uniformity, strength, and reliability across every load and every project.", bgClass: "bg-[#33353b]", textClass: "text-white", img: "/images/abstract2.png" },
  { num: "03", title: "Responsible Operations", desc: "We are committed to sustainable practices and environmentally responsible production, recognized through multiple government awards.", bgClass: "bg-[#a6cdce]", textClass: "text-gray-900", img: "/images/abstract3.png" }
];
---

<section id="why-us" class="scroll-mt-24 md:scroll-mt-28 py-6 md:py-10 px-4 sm:px-6 lg:px-8 w-full max-w-7xl mx-auto">
  <div class="mb-4 md:mb-7 text-center reveal-text">
    <h2 class="text-2xl sm:text-3xl md:text-[34px] font-satoshi font-bold tracking-tight text-gray-950">
      Why Choose Payyavoor Crushers?
    </h2>
  </div>

  <div class="flex flex-col md:flex-row w-full gap-3.5 lg:gap-5 min-h-[250px] sm:min-h-[270px] md:min-h-[290px] lg:min-h-[310px] h-auto why-us-container">
    {cards.map((card, index) => (
      <div class={`why-us-card relative rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow p-4 sm:p-5 lg:p-6 flex-1 flex flex-col justify-start min-h-[240px] sm:min-h-[260px] md:min-h-[280px] lg:min-h-[300px] ${card.bgClass} ${card.textClass}`}>
        <h3 class="text-base sm:text-lg lg:text-xl font-satoshi font-bold mb-2 z-10 leading-snug">{card.title}</h3>
        <p class="font-satoshi text-xs sm:text-[13px] lg:text-[14px] z-10 leading-relaxed font-medium opacity-90 max-w-sm">
          {card.desc}
        </p>
        
        <div class="mt-auto z-10 pt-3">
          <span class="text-lg sm:text-xl font-satoshi font-bold opacity-80">{card.num}</span>
        </div>

        {/* Abstract design elements */}
        <div class={`abstract-img-container opacity-0 absolute w-[55%] sm:w-[50%] md:w-[50%] h-[46%] pointer-events-none ${index === 1 ? '-bottom-5 md:-bottom-6 right-0' : index === 2 ? 'bottom-0 right-3 md:right-4' : 'bottom-0 right-2 md:right-3'}`}>
          <img src={card.img} alt="Abstract design" class="w-full h-full object-contain object-right-bottom opacity-75" />
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  const initWhyUs = () => {
    // Decisive slide-up into screen view
    gsap.from(".why-us-card", {
      scrollTrigger: {
        trigger: ".why-us-container",
        start: "top 85%",
        toggleActions: "play none none reverse"
      },
      y: 50,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out"
    });

    // Fade in abstract decorative graphics
    gsap.to(".abstract-img-container", {
      scrollTrigger: {
        trigger: ".why-us-container",
        start: "top 85%",
        toggleActions: "play none none reverse"
      },
      opacity: 1,
      duration: 0.7,
      stagger: 0.15,
      delay: 0.15,
      ease: "power2.inOut"
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWhyUs);
  } else {
    initWhyUs();
  }
</script>