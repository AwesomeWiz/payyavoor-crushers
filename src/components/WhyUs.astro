---
const cards = [
  { num: "01", title: "Proven Expertise", desc: "With decades of experience since 1995, we bring deep industry knowledge and a track record of delivering materials for major infrastructure projects.", bgClass: "bg-[#8dbcb6]", textClass: "text-gray-900", img: "/images/abstract1.png" },
  { num: "02", title: "Consistent Quality", desc: "Our aggregates are processed with precision to ensure uniformity, strength, and reliability across every load and every project.", bgClass: "bg-[#33353b]", textClass: "text-white", img: "/images/abstract2.png" },
  { num: "03", title: "Responsible Operations", desc: "We are committed to sustainable practices and environmentally responsible production, recognized through multiple government awards.", bgClass: "bg-[#a6cdce]", textClass: "text-gray-900", img: "/images/abstract3.png" }
];
---

<section id="why-us" class="pt-4 pb-8 md:pt-12 md:pb-12 px-4 w-full">
  <div class="mb-6 md:mb-12 text-center reveal-text">
    <h2 class="text-4xl md:text-5xl font-satoshi font-medium">Why Choose Us</h2>
  </div>

  <div class="flex flex-col md:flex-row w-full gap-4 px-2 md:px-8 min-h-[600px] h-auto why-us-container">
    {cards.map((card, index) => (
      <div class={`why-us-card relative rounded-xl overflow-hidden shadow-sm p-8 flex-1 flex flex-col justify-start min-h-[600px] ${card.bgClass} ${card.textClass}`}>
        <h3 class="text-2xl md:text-3xl font-satoshi font-semibold mb-4 z-10">{card.title}</h3>
        <p class="font-satoshi text-base md:text-lg z-10 leading-relaxed font-medium">
          {card.desc}
        </p>
        
        <div class="mt-auto z-10 pt-4">
          <span class="text-2xl font-satoshi font-medium opacity-90">{card.num}</span>
        </div>

        {/* Abstract images firmly pinned globally relative, responding via heights. Adjusting specifically abstract2 position mathematically. */}
        <div class={`abstract-img-container opacity-0 absolute w-[85%] md:w-2/3 h-[65%] lg:h-[75%] pointer-events-none ${index === 1 ? '-bottom-10 md:-bottom-12 right-0' : index === 2 ? 'bottom-0 right-[48px]' : 'bottom-0 right-[32px]'}`}>
          <img src={card.img} alt="Abstract design" class="w-full h-full object-contain object-right-bottom opacity-80" />
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    // Slant up effect (NO opacity fade! Purely Y-axis sliding up into screen view)
    gsap.from(".why-us-card", {
      scrollTrigger: {
        trigger: ".why-us-container",
        start: "top 80%",
        toggleActions: "play none none reverse"
      },
      y: 120,    // High positive Y start creates a decisive slide-up
      duration: 0.9,
      stagger: 0.2, // 1 -> 2 -> 3
      ease: "power4.out" // sharp deceleration
    });

    // Sub-animation: fade in explicitly ONLY the abstract images trailing the slide
    gsap.to(".abstract-img-container", {
      scrollTrigger: {
        trigger: ".why-us-container",
        start: "top 80%",
        toggleActions: "play none none reverse"
      },
      opacity: 1,
      duration: 0.8,
      stagger: 0.2,
      delay: 0.2,
      ease: "power2.inOut"
    });
  });
</script>
