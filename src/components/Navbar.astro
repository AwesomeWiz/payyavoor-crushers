---
---

<!-- Pill / floating island navbar wrapper -->
<div class="fixed top-6 left-0 right-0 flex justify-center z-[10001] px-4" id="navbar-wrapper">
  <nav
    id="navbar"
    class="
      w-full max-w-5xl
      flex flex-col
      px-4 md:px-8 py-2 md:py-3
      rounded-[24px] md:rounded-[40px]
      nav-dark-blue-gradient backdrop-blur-xl
      shadow-[0_8px_32px_0_rgba(0,0,0,0.15)]
      transition-all duration-500 ease-in-out
      overflow-hidden
    "
  >
    <!-- Main Bar -->
    <div class="flex items-center justify-between w-full">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="#" class="block group">
          <img 
            src="/images/logo.png" 
            alt="Payyavoor Crushers Logo" 
            class="h-12 md:h-14 w-auto transition-transform duration-300 group-hover:scale-105 logo-glow" 
          />
        </a>
      </div>

      <!-- Desktop Nav links -->
      <div class="hidden md:flex items-center gap-8 font-satoshi font-medium text-[16px] tracking-wide text-white/80">
        <a href="#about"    class="relative py-2 transition-colors duration-300 hover:text-white after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-sky-400 after:transition-all after:duration-300 hover:after:w-full">Who We Are</a>
        <a href="#products" class="relative py-2 transition-colors duration-300 hover:text-white after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-sky-400 after:transition-all after:duration-300 hover:after:w-full">Our Products</a>
        <a href="#why-us"   class="relative py-2 transition-colors duration-300 hover:text-white after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-sky-400 after:transition-all after:duration-300 hover:after:w-full">Why Choose Us</a>
        <a href="#awards-legacy" class="relative py-2 transition-colors duration-300 hover:text-white after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-sky-400 after:transition-all after:duration-300 hover:after:w-full">Awards</a>
      </div>

      <!-- CTA & Mobile Toggle -->
      <div class="flex items-center gap-4 md:gap-8">
        <a
          href="#contact"
          class="
            hidden sm:inline-block
            bg-brandBlue text-white
            px-6 md:px-8 py-2 md:py-3 rounded-full
            text-[13px] md:text-[14px] font-bold tracking-widest uppercase
            hover:bg-[#005a8d]
            transition-all duration-300
            shadow-lg shadow-brandBlue/20
            hover:shadow-brandBlue/40
            hover:-translate-y-0.5
            active:translate-y-0
          "
        >
          Get In Touch
        </a>
        
        <!-- Mobile menu toggle -->
        <button id="mobile-toggle" class="md:hidden p-2 text-white/95 focus:outline-none transition-transform active:scale-95" aria-label="Toggle Menu">
          <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Links (Expanded) -->
    <div id="mobile-menu" class="md:hidden max-h-0 opacity-0 transition-all duration-500 ease-in-out flex flex-col items-center gap-8 pt-0">
      <div class="w-full h-px bg-white/10 mt-2"></div>
      <a href="#about"    class="text-[22px] font-medium text-white/80 hover:text-white transition-colors">Who We Are</a>
      <a href="#products" class="text-[22px] font-medium text-white/80 hover:text-white transition-colors">Our Products</a>
      <a href="#why-us"   class="text-[22px] font-medium text-white/80 hover:text-white transition-colors">Why Choose Us</a>
      <a href="#awards-legacy" class="text-[22px] font-medium text-white/80 hover:text-white transition-colors">Awards</a>
      <a href="#contact"  class="sm:hidden bg-brandBlue text-white px-12 py-4 rounded-full text-[15px] font-bold tracking-widest uppercase mb-8 shadow-xl shadow-brandBlue/20">Get In Touch</a>
    </div>
  </nav>
</div>

<script>
  const nav = document.getElementById('navbar');
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  // Toggle mobile menu
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('max-h-[500px]');
    
    if (isOpen) {
      menu?.classList.remove('max-h-[500px]', 'opacity-100', 'pt-4', 'pb-4');
      menu?.classList.add('max-h-0', 'opacity-0', 'pt-0');
      hamburger?.classList.remove('hidden');
      close?.classList.add('hidden');
      // Restore scroll handle background (30% opacity)
      nav?.classList.add('nav-dark-blue-gradient');
      nav?.classList.remove('nav-dark-blue-solid');
    } else {
      menu?.classList.add('max-h-[500px]', 'opacity-100', 'pt-4', 'pb-4');
      menu?.classList.remove('max-h-0', 'opacity-0', 'pt-0');
      hamburger?.classList.add('hidden');
      close?.classList.remove('hidden');
      // More solid background when open for readability
      nav?.classList.remove('nav-dark-blue-gradient');
      nav?.classList.add('nav-dark-blue-solid');
    }
  });

  // Handle scroll behavior
  window.addEventListener('scroll', () => {
    const isMobileMenuOpen = menu?.classList.contains('max-h-[500px]');
    if (isMobileMenuOpen) return;

    if (window.scrollY > 50) {
      nav?.classList.add('!py-2', 'max-w-4xl', 'shadow-[0_12px_40px_0_rgba(0,0,0,0.12)]');
      nav?.classList.remove('max-w-5xl', 'shadow-[0_8px_32px_0_rgba(0,0,0,0.15)]');
    } else {
      nav?.classList.remove('!py-2', 'max-w-4xl', 'shadow-[0_12px_40px_0_rgba(0,0,0,0.12)]');
      nav?.classList.add('max-w-5xl', 'shadow-[0_8px_32px_0_rgba(0,0,0,0.15)]');
    }
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.remove('max-h-[500px]', 'opacity-100', 'pt-4', 'pb-4');
      menu?.classList.add('max-h-0', 'opacity-0', 'pt-0');
      hamburger?.classList.remove('hidden');
      close?.classList.add('hidden');
      nav?.classList.add('nav-dark-blue-gradient');
      nav?.classList.remove('nav-dark-blue-solid');
    });
  });
</script>

<style>
  .nav-dark-blue-gradient {
    background: linear-gradient(to right, rgba(7, 25, 52, 0.95) 0%, rgba(12, 38, 76, 0.78) 50%, rgba(7, 25, 52, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .nav-dark-blue-solid {
    background: linear-gradient(to right, rgba(7, 25, 52, 0.98) 0%, rgba(12, 38, 76, 0.95) 50%, rgba(7, 25, 52, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .logo-glow {
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.45));
  }

  @media (min-width: 768px) {
    .nav-dark-blue-gradient {
      background: linear-gradient(to right, rgba(7, 25, 52, 0.95) 0%, rgba(12, 38, 76, 0.6) 50%, rgba(7, 25, 52, 0.95) 100%);
    }
  }
</style>
