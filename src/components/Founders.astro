---
---

{/* Founders Tribute Section */}
<section id="founders" class="relative py-12 md:py-20 overflow-hidden">
  {/* Subtle background texture */}
  <div class="absolute inset-0 bg-gradient-to-b from-brandBg via-[#f5f0e8] to-brandBg opacity-60"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-16">
    
    {/* Section Header */}
    <div class="text-center mb-16 md:mb-24" id="founders-header">
      <p class="text-sm md:text-base uppercase tracking-[0.3em] text-gray-400 mb-4 font-satoshi">In Loving Memory</p>
      <h3 class="text-3xl md:text-5xl font-serif leading-tight text-gray-900">
        The Visionaries Behind<br />Our Legacy
      </h3>
      <div class="w-16 h-[2px] bg-gradient-to-r from-transparent via-gray-400 to-transparent mx-auto mt-8"></div>
    </div>

    {/* Founders Cards */}
    <div class="flex flex-col lg:flex-row items-center lg:items-start justify-center gap-10 lg:gap-8 xl:gap-16" id="founders-cards">
      
      {/* Founder 1 - Late Mr. K.J. Jose */}
      <div class="founder-card group relative w-[280px] sm:w-[320px] lg:w-[290px] xl:w-[320px]" id="founder-jose">
        <div class="founder-card-inner relative">
          {/* Glow effect behind card */}
          <div class="absolute -inset-4 bg-gradient-to-br from-amber-200/30 via-transparent to-amber-100/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          
          {/* Photo container */}
          <div class="relative overflow-hidden rounded-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.15)] group-hover:shadow-[0_30px_80px_-15px_rgba(0,0,0,0.25)] transition-shadow duration-700">
            {/* Decorative corner accent */}
            <div class="absolute top-0 left-0 w-16 h-16 z-20">
              <div class="absolute top-3 left-3 w-6 h-[1px] bg-white/60"></div>
              <div class="absolute top-3 left-3 w-[1px] h-6 bg-white/60"></div>
            </div>
            <div class="absolute bottom-0 right-0 w-16 h-16 z-20">
              <div class="absolute bottom-3 right-3 w-6 h-[1px] bg-white/60"></div>
              <div class="absolute bottom-3 right-3 w-[1px] h-6 bg-white/60"></div>
            </div>
            
            {/* Image with zoom on hover */}
            <div class="aspect-[3/4] overflow-hidden">
              <img 
                src="/images/founder-kj-jose.jpeg" 
                alt="Late Mr. K.J. Jose - Co-Founder of Payyavoor Group"
                class="w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-110"
                loading="lazy"
              />
            </div>

            {/* Gradient overlay at bottom */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            
            {/* Memorial candle icon */}
            <div class="absolute top-4 right-4 z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-2 group-hover:translate-y-0">
              <div class="w-8 h-8 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center">
                <svg class="w-4 h-4 text-amber-300 candle-flicker" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C12 2 9 7 9 10C9 11.66 10.34 13 12 13C13.66 13 15 11.66 15 10C15 7 12 2 12 2Z M11 14V22H13V14H11Z"/>
                </svg>
              </div>
            </div>

            {/* Name overlay */}
            <div class="absolute bottom-0 left-0 right-0 p-5 z-10">
              <p class="text-white/60 text-xs uppercase tracking-[0.2em] mb-1 font-satoshi">Co-Founder</p>
              <h4 class="text-white text-xl md:text-2xl font-serif leading-tight">Late Mr. K.J. Jose</h4>
            </div>
          </div>

          {/* Quote / tribute text below card */}
          <div class="mt-6 text-center opacity-0 group-hover:opacity-100 transition-all duration-700 translate-y-4 group-hover:translate-y-0">
            <p class="text-gray-500 text-sm italic font-serif leading-relaxed">
              "A pioneer whose vision<br />built an empire from stone."
            </p>
          </div>
        </div>
      </div>

      {/* Divider 1 - vertical line between cards */}
      <div class="hidden lg:block w-[1px] h-48 bg-gradient-to-b from-transparent via-gray-300 to-transparent founders-divider"></div>
      {/* Mobile/Tablet divider */}
      <div class="lg:hidden w-48 h-[1px] bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>

