              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-300 candle-flicker" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C12 2 9 7 9 10C9 11.66 10.34 13 12 13C13.66 13 15 11.66 15 10C15 7 12 2 12 2Z M11 14V22H13V14H11Z"/>
