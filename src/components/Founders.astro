            <div class="hidden sm:block absolute bottom-0 right-0 w-12 sm:w-16 h-12 sm:h-16 z-20">
              <div class="absolute bottom-2 sm:bottom-3 right-2 sm:right-3 w-4 sm:w-6 h-[1px] bg-white/60"></div>
              <div class="absolute bottom-2 sm:bottom-3 right-2 sm:right-3 w-[1px] h-4 sm:h-6 bg-white/60"></div>
            </div>
            
            {/* Image with zoom on hover */}
            <div class="aspect-[3/4] overflow-hidden">
              <img 
                src="/images/kujoseph.jpg" 
                alt="Late Mr. K.U. Joseph - Co-Founder of Payyavoor Group"
                class="w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-110"
                loading="lazy"
              />
            </div>

            {/* Gradient overlay at bottom */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
            
            {/* Memorial candle icon */}
            <div class="hidden sm:flex absolute top-3 sm:top-4 right-3 sm:right-4 z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-2 group-hover:translate-y-0">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-300 candle-flicker" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C12 2 9 7 9 10C9 11.66 10.34 13 12 13C13.66 13 15 11.66 15 10C15 7 12 2 12 2Z M11 14V22H13V14H11Z"/>
                </svg>
              </div>
            </div>

            {/* Name overlay */}
            <div class="absolute bottom-0 left-0 right-0 p-2 sm:p-3.5 lg:p-5 z-10 text-left">
              <p class="text-white/70 text-[8px] sm:text-[10px] lg:text-xs uppercase tracking-wider mb-0.5 font-satoshi">Co-Founder</p>
              <h4 class="text-white text-[11px] sm:text-sm lg:text-xl xl:text-2xl font-serif font-medium leading-tight">Late Mr. K.U. Joseph</h4>
            </div>
          </div>

          {/* Quote / tribute text below card (Desktop only) */}
          <div class="hidden lg:block mt-6 text-center opacity-0 group-hover:opacity-100 transition-all duration-700 translate-y-4 group-hover:translate-y-0">
            <p class="text-gray-500 text-sm italic font-serif leading-relaxed">
              "A pillar of strength whose wisdom<br />guided our path."
            </p>
          </div>
        </div>
      </div>

      {/* Desktop Divider between Joseph & Mathai */}
      <div class="hidden lg:block w-[1px] h-48 bg-gradient-to-b from-transparent via-gray-300 to-transparent founders-divider lg:order-4"></div>

      {/* Founder 3 - Late Mr. K.J. Mathai (2nd on mobile, 3rd on desktop) */}
      <div class="founder-card group relative w-full lg:w-[290px] xl:w-[320px] order-2 lg:order-5" id="founder-mathai">
        <div class="founder-card-inner relative">
          {/* Glow effect behind card */}
          <div class="absolute -inset-4 bg-gradient-to-br from-amber-200/30 via-transparent to-amber-100/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          
          {/* Photo container */}
          <div class="relative overflow-hidden rounded-xl sm:rounded-2xl shadow-md lg:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.15)] group-hover:shadow-[0_30px_80px_-15px_rgba(0,0,0,0.25)] transition-shadow duration-700">
            {/* Decorative corner accent */}
            <div class="hidden sm:block absolute top-0 left-0 w-12 sm:w-16 h-12 sm:h-16 z-20">
              <div class="absolute top-2 sm:top-3 left-2 sm:left-3 w-4 sm:w-6 h-[1px] bg-white/60"></div>
              <div class="absolute top-2 sm:top-3 left-2 sm:left-3 w-[1px] h-4 sm:h-6 bg-white/60"></div>
            </div>
            <div class="hidden sm:block absolute bottom-0 right-0 w-12 sm:w-16 h-12 sm:h-16 z-20">
              <div class="absolute bottom-2 sm:bottom-3 right-2 sm:right-3 w-4 sm:w-6 h-[1px] bg-white/60"></div>
              <div class="absolute bottom-2 sm:bottom-3 right-2 sm:right-3 w-[1px] h-4 sm:h-6 bg-white/60"></div>
            </div>
            
            {/* Image with zoom on hover */}
            <div class="aspect-[3/4] overflow-hidden">
