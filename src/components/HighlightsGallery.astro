---
// Quarry and company images for the scrolling photo gallery
const images = [
  "/images/award1.jpg",
  "/images/tree.jpeg",
  "/images/alltrophy1.jpeg",
  "/images/award2.jpeg",
  "/images/office.jpeg",
  "/images/mist.png",
];
---

<section class="relative w-full overflow-hidden bg-brandBg">
  <!-- 1. Highlights Strip below the customers we served -->
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 md:px-14 lg:px-16 pt-10 sm:pt-14 md:pt-28 pb-10 sm:pb-14 md:pb-28 reveal-text">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 md:gap-8 lg:gap-12 text-center md:text-left">
      
      <!-- Point 1: Experience & Heritage -->
      <div class="flex flex-col justify-center">
        <h2 class="text-xl sm:text-2xl md:text-[26px] lg:text-3xl font-semibold text-gray-900 tracking-tight font-satoshi">
          30+ Years of Experience
          <span class="block text-sm sm:text-base md:text-xl font-normal text-gray-500 mt-1 sm:mt-1.5 font-satoshi">
            Started in 1995
          </span>
        </h2>
      </div>

      <!-- Point 2: Customers Served -->
      <div class="flex flex-col justify-center border-t md:border-t-0 md:border-l border-gray-200 pt-6 md:pt-0 md:pl-8 lg:pl-12">
        <h2 class="text-xl sm:text-2xl md:text-[26px] lg:text-3xl font-semibold text-gray-900 tracking-tight font-satoshi">
          10,000+ Customers Served
          <span class="block text-sm sm:text-base md:text-xl font-normal text-gray-500 mt-1 sm:mt-1.5 font-satoshi">
            A Legacy of Reliability
          </span>
        </h2>
      </div>

      <!-- Point 3: Finnish Technology Machinery -->
      <div class="flex flex-col justify-center border-t md:border-t-0 md:border-l border-gray-200 pt-6 md:pt-0 md:pl-8 lg:pl-12">
        <h2 class="text-xl sm:text-2xl md:text-[26px] lg:text-3xl font-semibold text-gray-900 tracking-tight font-satoshi">
          Finnish Technology
          <span class="block text-sm sm:text-base md:text-xl font-normal text-gray-500 mt-1 sm:mt-1.5 font-satoshi">
            World-Class Machinery
          </span>
        </h2>
      </div>

    </div>
  </div>

  <!-- 2. Scrolling photo gallery images matching Key Projects card size -->
  <div
    id="hero-carousel"
    class="w-full relative pt-10 sm:pt-14 md:pt-28 pb-12 sm:pb-16 md:pb-36 bg-transparent overflow-hidden"
  >
    <div class="flex animate-carousel w-fit gap-3 md:gap-4 px-3 md:px-5">
      {/* Group 1 */}
      {
        images.map((src) => (
          <div class="h-[180px] sm:h-[220px] md:h-80 w-[240px] sm:w-[280px] md:w-[420px] flex-shrink-0 rounded-xl md:rounded-2xl overflow-hidden shadow-[0_10px_30px_-10px_rgba(0,0,0,0.15)] md:shadow-[0_20px_50px_-15px_rgba(0,0,0,0.15)]">
            <img
              src={src}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              alt="Quarry and facility"
              loading="lazy"
            />
          </div>
        ))
      }
      {/* Group 2 */}
      {
        images.map((src) => (
          <div class="h-[180px] sm:h-[220px] md:h-80 w-[240px] sm:w-[280px] md:w-[420px] flex-shrink-0 rounded-xl md:rounded-2xl overflow-hidden shadow-[0_10px_30px_-10px_rgba(0,0,0,0.15)] md:shadow-[0_20px_50px_-15px_rgba(0,0,0,0.15)]">
            <img
              src={src}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              alt="Quarry and facility"
              loading="lazy"
            />
          </div>
        ))
      }
      {/* Group 3 */}
      {
        images.map((src) => (
          <div class="h-[180px] sm:h-[220px] md:h-80 w-[240px] sm:w-[280px] md:w-[420px] flex-shrink-0 rounded-xl md:rounded-2xl overflow-hidden shadow-[0_10px_30px_-10px_rgba(0,0,0,0.15)] md:shadow-[0_20px_50px_-15px_rgba(0,0,0,0.15)]">
            <img
              src={src}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              alt="Quarry and facility"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes carousel {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.3333333333%);
    }
  }

  .animate-carousel {
    display: flex;
    animation: carousel 60s linear infinite;
  }
</style>
