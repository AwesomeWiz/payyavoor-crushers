<section id="about" class="pt-8 md:pt-16 pb-12 md:pb-24 px-6 md:px-16 min-h-[60vh] md:min-h-screen flex flex-col justify-center max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row justify-between mb-12 md:mb-24 font-satoshi reveal-text">
    <div class="md:w-1/3 mb-8 md:mb-0">
      <h2 class="text-4xl md:text-5xl font-medium tracking-tight">Who We Are</h2>
    </div>
    <div class="md:w-1/2">
      <p class="text-lg md:text-2xl text-gray-800 leading-relaxed mb-6 font-medium">
        Payyavoor Crushers is a trusted name in granite mining and aggregate production since 1995. With decades of experience, we deliver high-quality materials for roads, bridges, and major infrastructure projects. Known for our reliability and sustainable practices, we continue to support the construction industry with consistency and precision.
      </p>
      <p class="text-sm md:text-base text-gray-600">
        Every material we produce is backed by <span class="underline underline-offset-4 decoration-gray-400">experience</span>, <span class="underline underline-offset-4 decoration-gray-400">consistency</span>, and a focus on <span class="underline underline-offset-4 decoration-gray-400">responsible operations</span>.
      </p>
    </div>
  </div>

  <div class="text-center font-serif text-5xl md:text-7xl leading-tight mb-16 reveal-text">
    Precision in Every<br />
    Crush. Strength in<br />
    Every Build.
  </div>

</section>

{/* Full width video section natively removed from max-w constraints */}
<div id="reveal-container" class="w-full h-[100vh] flex items-center justify-center bg-transparent overflow-hidden relative">
  {/* The container itself scales linearly from 0 to 1 taking perfect full width */}
  <div id="reveal-media" class="w-[100vw] h-[100vh] origin-center flex flex-col justify-center items-center overflow-hidden bg-transparent" style="transform: scaleY(0);">
    {/* By setting the physical video to 100vh width and 100vw height then rotating -90deg, it visually becomes 100vw width and 100vh height! Perfect full stretch coverage avoiding any black gaps. */}
    <video src="/video/payyavoor.mp4" autoplay loop muted playsinline class="object-cover" style="width: 100vh; height: 100vw; transform: rotate(-90deg); max-width: none; min-width: 100vh; min-height: 100vw;"></video>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    
    // Animate scaleY pixel stretch explicitly natively mirroring full boundaries
    gsap.to("#reveal-media", {
      scrollTrigger: {
        trigger: "#reveal-container",
        start: "top top", // Lock when viewport hits top
        end: "+=1200", 
        pin: true, 
        scrub: 1, 
      },
      scaleY: 1,
      ease: "none"
    });
    
  });
</script>
