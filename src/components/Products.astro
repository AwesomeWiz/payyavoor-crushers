---
const products = [
  { name: "P SAND", desc: "Fine, smooth texture ideal for plastering applications", img: "https://5.imimg.com/data5/IOS/Default/2023/4/302151310/UX/MS/GC/164138792/product-jpeg-500x500.png" },
  { name: "M SAND", desc: "Premium manufactured sand for strong concrete", img: "/images/msand.jpg" },
  { name: "40MM", desc: "Heavy aggregates for foundations and roads", img: "https://5.imimg.com/data5/SELLER/Default/2024/11/467879402/LG/HP/CB/94115244/untitled-design-1-500x500.jpg" },
  { name: "20MM", desc: "Strong aggregates for concrete structures", img: "/images/12mm.jpg" },
  { name: "12MM", desc: "Durable aggregates for RCC works", img: "/images/12mm.jpg" },
  { name: "6MM", desc: "Fine aggregates for precision construction", img: "/images/12mm.jpg" },
  { name: "DUST", desc: "Fine material for filling and leveling", img: "/images/12mm.jpg" },
  { name: "WMM", desc: "High-strength mix for road construction", img: "/images/12mm.jpg" },
  { name: "GSB", desc: "Reliable base material for road works", img: "/images/12mm.jpg" }
];
---

<section id="products" class="scroll-mt-16 md:scroll-mt-20 w-full relative bg-brandBg overflow-x-hidden pb-12 md:pb-16 select-none">

  <!-- Heading -->
  <div class="w-full text-center pt-8 md:pt-12 pb-4 relative z-10 select-none">
    <span class="inline-block text-[10px] font-bold text-brandBlue tracking-[0.3em] uppercase mb-1.5 font-satoshi">
      OUR MATERIALS
    </span>
    <h2 class="text-3xl md:text-5xl font-bold tracking-wide uppercase text-transparent bg-clip-text bg-gradient-to-r from-gray-900 via-gray-800 to-[#007eb5] mb-2" style="font-family: 'Montserrat', sans-serif;">
      Our Products
    </h2>
    <div class="w-12 h-0.5 bg-gradient-to-r from-[#007eb5] to-transparent mx-auto mt-2"></div>
  </div>

  <!-- Desktop view: Pinned Stage Slider -->
  <div class="hidden lg:block relative w-full overflow-visible px-12">
    <!-- Left Arrow Navigation -->
    <div class="absolute left-8 top-1/2 -translate-y-1/2 z-30 pointer-events-none flex">
      <button class="nav-arrow-left w-12 h-12 rounded-full bg-[#000428]/85 hover:bg-[#004e92] border border-white/10 text-white flex items-center justify-center shadow-lg shadow-brandBlue/10 pointer-events-auto transition-all duration-300 hover:scale-110 active:scale-95 disabled:opacity-30 disabled:pointer-events-none" aria-label="Previous product">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
    </div>

    <!-- Slider Stage Container -->
    <div class="slider-stage-container w-full h-[500px] flex items-center justify-start relative overflow-x-auto scrollbar-hide py-8">
      <!-- Slider Track -->
      <div class="slider-track flex items-center gap-12">
        {products.map((product, index) => (
          <div class="product-card rounded-[24px] overflow-hidden group shadow-2xl flex flex-col justify-between relative cursor-pointer" data-index={index}>
            <!-- Card Image Background -->
            <div class="w-full h-full absolute inset-0 z-0 rounded-[24px] overflow-hidden">
              <img src={product.img} alt={product.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 pointer-events-none rounded-[24px]" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-transparent rounded-[24px]"></div>
            </div>

            <!-- Glossy Sheen Overlay -->
            <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/[0.015] to-white/[0.06] pointer-events-none z-10"></div>
            
            <!-- Card Content -->
            <div class="absolute bottom-6 left-5 right-5 text-white z-20">
              <h3 class="text-xl md:text-3xl font-bold font-satoshi mb-2 tracking-tight">{product.name}</h3>
              <p class="text-[11px] md:text-[12px] font-satoshi w-11/12 text-gray-200 leading-relaxed">{product.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Arrow Navigation -->
    <div class="absolute right-8 top-1/2 -translate-y-1/2 z-30 pointer-events-none flex">
      <button class="nav-arrow-right w-12 h-12 rounded-full bg-[#000428]/85 hover:bg-[#004e92] border border-white/10 text-white flex items-center justify-center shadow-lg shadow-brandBlue/10 pointer-events-auto transition-all duration-300 hover:scale-110 active:scale-95 disabled:opacity-30 disabled:pointer-events-none" aria-label="Next product">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile view: 3D Cylindrical Swiper Carousel -->
  <div class="lg:hidden w-full overflow-visible py-4 mobile-perspective">
    <div class="mobile-slider-container w-full h-[360px] flex items-center justify-start overflow-x-auto scrollbar-hide snap-x snap-mandatory">
      <div class="mobile-slider-track flex items-center gap-6">
        {products.map((product, index) => (
          <div class="mobile-product-card snap-center flex-shrink-0 w-[230px] h-[320px] flex items-center justify-center relative cursor-pointer" data-index={index}>
            <div class="mobile-card-3d w-full h-full relative rounded-[20px] overflow-hidden flex flex-col justify-end border border-white/5 shadow-xl">
              <!-- Card Image Background -->
              <div class="w-full h-full absolute inset-0 z-0 rounded-[20px] overflow-hidden">
                <img src={product.img} alt={product.name} class="w-full h-full object-cover pointer-events-none rounded-[20px]" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent rounded-[20px]"></div>
              </div>

              <!-- Glossy Sheen Overlay -->
              <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/[0.01] to-white/[0.04] pointer-events-none z-10"></div>
              
              <!-- Card Content -->
              <div class="p-5 text-white z-20">
                <h3 class="text-xl font-bold font-satoshi mb-1.5 tracking-tight">{product.name}</h3>
                <p class="text-[11px] font-satoshi text-gray-200 leading-relaxed">{product.desc}</p>
              </div>

              <!-- Mobile Sheen sweep -->
              <div class="mobile-sheen absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full pointer-events-none z-30"></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile Scroll indicator hint -->
    <div class="w-full flex justify-center mt-3 text-gray-400 font-satoshi text-[10px] tracking-widest uppercase items-center gap-2 select-none opacity-50">
      Swipe left or right
    </div>
  </div>

  <!-- Scroll Indicator Hint (Desktop only) -->
  <div class="hidden lg:flex w-full justify-center mt-4 text-gray-400 font-satoshi text-xs tracking-widest uppercase items-center gap-2 select-none opacity-60 relative z-20">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 13l-7 7-7-7m14-6l-7 7-7-7" />
    </svg>
    Scroll to browse products
  </div>
</section>

<style>
  .slider-stage-container {
    perspective: 1000px;
  }

  .slider-track {
    transform-style: preserve-3d;
  }

  .product-card {
    flex-shrink: 0;
    width: 280px;
    height: 380px;
    position: relative;
    will-change: transform, opacity, filter;
    transform-style: preserve-3d;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 10px 30px -10px rgba(0, 78, 146, 0.15), 0 5px 15px -10px rgba(0, 4, 40, 0.2);
    /* Smooth transitions when active classes are toggled */
    transition: 
      box-shadow 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), 
      border-color 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), 
      transform 0.45s cubic-bezier(0.25, 0.8, 0.25, 1),
      filter 0.45s cubic-bezier(0.25, 0.8, 0.25, 1),
      opacity 0.45s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .mobile-perspective {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .mobile-slider-track {
    transform-style: preserve-3d;
    will-change: padding-left, padding-right;
  }

  .mobile-product-card {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .mobile-card-3d {
    will-change: transform, opacity, filter, box-shadow, border-color;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out; /* Damping */
  }

  /* Tactile touch-down compression on mobile */
  .mobile-product-card:active .mobile-card-3d {
    transform: scale(0.95) translateY(2px) !important;
  }

  .mobile-sheen {
    width: 200%;
    transform: skewX(-25deg);
    will-change: transform;
  }

  /* Subpixel anti-aliasing fix on rounded corners */
  .product-card, .product-card *, .mobile-product-card, .mobile-product-card * {
    backface-visibility: hidden;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (typeof window !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener("DOMContentLoaded", () => {
      const container = document.querySelector('.slider-stage-container') as HTMLElement;
      const track = document.querySelector('.slider-track') as HTMLElement;
      const cards = document.querySelectorAll('.product-card');
      const leftArrow = document.querySelector('.nav-arrow-left') as HTMLButtonElement;
      const rightArrow = document.querySelector('.nav-arrow-right') as HTMLButtonElement;

      if (!container || !track || !cards.length) return;

      let triggerInstance: any = null;

      // 1. Dynamic Padding Setup (Centers the first and last card)
      function resizePadding() {
        const cardWidth = cards[0].clientWidth;
        const padVal = (container.clientWidth / 2) - (cardWidth / 2);
        track.style.paddingLeft = `${padVal}px`;
        track.style.paddingRight = `${padVal}px`;
      }

      // 2. Card Focus logic (grays out other cards, zooms center one, adds glow)
      function updateActiveStates() {
        const containerCenter = container.getBoundingClientRect().left + container.clientWidth / 2;

        let closestCardIndex = 0;
        let minDistance = Infinity;

        cards.forEach((card, index) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(containerCenter - cardCenter);

          if (distance < minDistance) {
            minDistance = distance;
            closestCardIndex = index;
          }
        });

        cards.forEach((card, index) => {
          const cardElem = card as HTMLElement;
          const isCenter = index === closestCardIndex;

          const d = index - closestCardIndex;
          let rotateYVal = 0;
          if (d < 0) {
            rotateYVal = 10;
          } else if (d > 0) {
            rotateYVal = -10;
          }

          if (isCenter) {
            cardElem.classList.add('is-active');
            gsap.to(cardElem, {
              scale: 1.06,
              opacity: 1,
              rotateY: 0,
              filter: "grayscale(0%)",
              boxShadow: "0 25px 60px -10px rgba(0, 78, 146, 0.45), 0 15px 35px -15px rgba(0, 4, 40, 0.5)",
              borderColor: "rgba(255, 255, 255, 0.25)",
              duration: 0.45,
              ease: "power2.out",
              overwrite: "auto"
            });
          } else {
            cardElem.classList.remove('is-active');
            gsap.to(cardElem, {
              scale: 0.9,
              opacity: 0.5,
              rotateY: rotateYVal,
              filter: "grayscale(100%)",
              boxShadow: "0 10px 30px -10px rgba(0, 78, 146, 0.1), 0 5px 15px -10px rgba(0, 4, 40, 0.15)",
              borderColor: "rgba(255, 255, 255, 0.05)",
              duration: 0.45,
              ease: "power2.out",
              overwrite: "auto"
            });
          }
        });

        if (leftArrow) leftArrow.disabled = closestCardIndex === 0;
        if (rightArrow) rightArrow.disabled = closestCardIndex === cards.length - 1;
      }

      // 3. Scroll to specific card function
      function scrollToCard(index: number) {
        if (index < 0 || index >= cards.length) return;

        if (triggerInstance) {
          const start = triggerInstance.start;
          const end = triggerInstance.end;
          const scrollRange = end - start;
          const targetScroll = start + (index / (cards.length - 1)) * scrollRange;

          window.scrollTo({
            top: targetScroll,
            behavior: 'smooth'
          });
        }
      }

      // 4. Arrow navigation binding
      leftArrow?.addEventListener('click', () => {
        const activeCard = document.querySelector('.product-card.is-active');
        if (activeCard) {
          const index = parseInt(activeCard.getAttribute('data-index') || '0');
          scrollToCard(index - 1);
        }
      });

      rightArrow?.addEventListener('click', () => {
        const activeCard = document.querySelector('.product-card.is-active');
        if (activeCard) {
          const index = parseInt(activeCard.getAttribute('data-index') || '0');
          scrollToCard(index + 1);
        }
      });

      // Card click focusing
      cards.forEach((card, index) => {
        card.addEventListener('click', () => {
          scrollToCard(index);
        });
      });

      // 5. GSAP Responsive MatchMedia Setup
      const mm = gsap.matchMedia();

      // Desktop layout (pinned scrolling)
      mm.add("(min-width: 1024px)", () => {
        // Initialize padding first
        resizePadding();
        
        container.style.overflowX = 'hidden';
        gsap.set(track, { x: 0 });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: "#products",
            start: "center center",
            end: () => `+=${track.scrollWidth - container.clientWidth + 500}`,
            pin: true,
            scrub: 0.8,
            invalidateOnRefresh: true,
            onUpdate: () => {
              updateActiveStates();
            }
          }
        });

        tl.to(track, {
          x: () => -(track.scrollWidth - container.clientWidth),
          ease: "none"
        });

        triggerInstance = tl.scrollTrigger;

        setTimeout(updateActiveStates, 100);

        return () => {
          gsap.set(track, { x: 0 });
          container.style.overflowX = 'hidden';
          triggerInstance = null;
        };
      });

      // Mobile/Tablet layout (native vertical grid scroll reveal + scroll tilt + tap sheen)
      mm.add("(max-width: 1023px)", () => {
        const mContainer = document.querySelector('.mobile-slider-container') as HTMLElement;
        const mTrack = document.querySelector('.mobile-slider-track') as HTMLElement;
        const mCards = document.querySelectorAll('.mobile-product-card');

        if (!mContainer || !mTrack || !mCards.length) return;

        // Dynamic Padding Setup
        function resizeMobilePadding() {
          const cardWidth = mCards[0].clientWidth;
          const padVal = (mContainer.clientWidth / 2) - (cardWidth / 2);
          mTrack.style.paddingLeft = `${padVal}px`;
          mTrack.style.paddingRight = `${padVal}px`;
        }

        // 3D Cylindrical Cylinder Transform Loop
        function updateMobile3DStates() {
          const containerCenter = mContainer.getBoundingClientRect().left + mContainer.clientWidth / 2;

          let closestIndex = 0;
          let minDistance = Infinity;

          mCards.forEach((card, index) => {
            const cardRect = card.getBoundingClientRect();
            const cardCenter = cardRect.left + cardRect.width / 2;
            const distance = Math.abs(containerCenter - cardCenter);
            if (distance < minDistance) {
              minDistance = distance;
              closestIndex = index;
            }
          });

          mCards.forEach((card, index) => {
            const cardElem = card as HTMLElement;
            const cardInner = cardElem.querySelector('.mobile-card-3d') as HTMLElement;
            if (!cardInner) return;

            const cardRect = cardElem.getBoundingClientRect();
            const cardCenter = cardRect.left + cardRect.width / 2;
            
            const maxDistance = mContainer.clientWidth / 2;
            const distance = cardCenter - containerCenter;
            const progress = Math.max(-1.2, Math.min(1.2, distance / maxDistance)); // Normalized position relative to center

            const isCenter = index === closestIndex;

            // 3D cylinder properties
            const rotateYVal = progress * 35; // Angling inward
            const translateZVal = -Math.abs(progress) * 120; // Pushing back
            const scaleVal = 1 - Math.abs(progress) * 0.1; // Shrinking
            const opacityVal = 1 - Math.abs(progress) * 0.45; // Fading
            const grayscaleVal = Math.abs(progress) * 90; // Grayscaling

            gsap.set(cardInner, {
              rotateY: rotateYVal,
              z: translateZVal,
              scale: scaleVal,
              opacity: opacityVal,
              filter: `grayscale(${grayscaleVal}%)`,
              boxShadow: isCenter 
                ? "0 20px 45px -10px rgba(0, 78, 146, 0.4), 0 10px 25px -12px rgba(0, 4, 40, 0.45)"
                : "0 8px 24px -12px rgba(0, 78, 146, 0.1), 0 4px 12px -12px rgba(0, 4, 40, 0.15)",
              borderColor: isCenter ? "rgba(255, 255, 255, 0.22)" : "rgba(255, 255, 255, 0.05)"
            });
          });
        }

        // Tap Sheen Animation trigger
        mCards.forEach((card, index) => {
          const cardElem = card as HTMLElement;
          const sheen = cardElem.querySelector('.mobile-sheen');

          // Trigger sheen sweep on tap
          cardElem.addEventListener('click', () => {
            if (sheen) {
              gsap.fromTo(sheen,
                { x: '-100%' },
                { x: '100%', duration: 0.75, ease: "power2.out" }
              );
            }
          });

          // Snap scroll to card center on tap
          cardElem.addEventListener('click', () => {
            const targetScrollLeft = cardElem.offsetLeft - (mContainer.clientWidth - cardElem.clientWidth) / 2;
            gsap.to(mContainer, {
              scrollLeft: targetScrollLeft,
              duration: 0.4,
              ease: "power2.out",
              onUpdate: () => updateMobile3DStates()
            });
          });
        });

        // Event listeners
        mContainer.addEventListener('scroll', updateMobile3DStates);
        window.addEventListener('resize', resizeMobilePadding);

        // Init
        resizeMobilePadding();
        // Slight delay to ensure layout is complete
        setTimeout(() => {
          updateMobile3DStates();
        }, 150);

        return () => {
          mContainer.removeEventListener('scroll', updateMobile3DStates);
          window.removeEventListener('resize', resizeMobilePadding);
        };
      });

      // Resize event handler
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) {
          resizePadding();
          updateActiveStates();
        }
      });
    });
  }
</script>