---
const products = [
  { name: "P Sand", desc: "Fine, smooth texture ideal for plastering applications", img: "https://5.imimg.com/data5/IOS/Default/2023/4/302151310/UX/MS/GC/164138792/product-jpeg-500x500.png" },
  { name: "M Sand", desc: "Premium manufactured sand for strong concrete", img: "/images/msand.jpg" },
  {name: "40mm", desc: "Heavy aggregates for foundations and roads", img: "https://5.imimg.com/data5/SELLER/Default/2024/11/467879402/LG/HP/CB/94115244/untitled-design-1-500x500.jpg" },
  {name: "20mm", desc: "Strong aggregates for concrete structures", img: "/images/12mm.jpg" },
  { name: "12mm", desc: "Durable aggregates for RCC works", img: "/images/12mm.jpg" },
  { name: "6mm", desc: "Fine aggregates for precision construction", img: "/images/12mm.jpg" },
  {name: "Dust", desc: "Fine material for filling and leveling", img: "/images/12mm.jpg" },
  { name: "WMM", desc: "High-strength mix for road construction", img: "/images/12mm.jpg" },
  {name: "GSB", desc: "Reliable base material for road works", img: "/images/12mm.jpg" }

];
---

<section id="products" class="scroll-mt-16 md:scroll-mt-20 w-full relative bg-brandBg overflow-hidden pb-12 md:pb-8">

  {/* Heading */}
  <div class="w-full text-center pt-4 md:pt-6 pb-3 relative z-10 reveal-text">
    <h2 class="text-4xl md:text-5xl font-satoshi font-medium mb-2">Our Products</h2>
    <p class="font-serif text-2xl md:text-3xl text-gray-800">Engineered Aggregates for Every Need</p>
  </div>

  {/* Container */}
  <div class="pin-container w-full min-h-[55vh] md:h-[550px] mt-2 md:mt-4 flex items-center relative overflow-hidden scroll-smooth snap-none">

    {/* Scroll Area */}
    <div class="product-right w-full h-full flex items-center justify-start relative z-10 w-max" id="horizontal-track-container">

      <div id="horizontal-track" class="flex gap-4 md:gap-12 items-center h-full w-max pl-4 md:pl-16 pr-6 md:pr-32">

        {products.map((product) => (
          <div class="product-card snap-center flex-shrink-0 w-[280px] md:w-[400px] h-[350px] md:h-[450px] relative rounded-[16px] overflow-hidden group shadow-lg bg-white">
            
            <img src={product.img} alt={product.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />

            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

            <div class="absolute bottom-6 left-6 text-white z-10">
              <h3 class="text-2xl md:text-4xl font-satoshi font-semibold mb-2">{product.name}</h3>
              <p class="text-sm md:text-base font-satoshi w-5/6 text-gray-200">{product.desc}</p>
            </div>

          </div>
        ))}

      </div>

    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (typeof window !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener("DOMContentLoaded", () => {
      const track = document.getElementById('horizontal-track');
      if (!track) return;
      const cards = document.querySelectorAll('.product-card');

      const scrollAmount = track.scrollWidth - window.innerWidth;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".pin-container",
          start: "center center",
          end: `+=${scrollAmount * 1.2}`,
          pin: true,
          scrub: 1,
          snap: {
            snapTo: 1 / (cards.length - 1),
            duration: 0.5,
            ease: "power1.inOut"
          }
        }
      });

      tl.to(track, {
        x: -scrollAmount,
        ease: "none",
        duration: scrollAmount * 1.2
      }, 0);
    });
  }
</script>