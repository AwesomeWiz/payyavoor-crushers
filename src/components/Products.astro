---
const products = [
  {
    name: "M-SAND",
    sub: "Manufactured Sand",
    desc: "Engineered for superior concrete bonding, strength, and longevity.",
    img: "/images/msand.jpg"
  },
  {
    name: "P-SAND",
    sub: "Plastering Sand",
    desc: "Super-fine washed sand delivering smooth, crack-resistant plastering.",
    img: "/images/psand.jpg"
  },
  {
    name: "40 MM",
    sub: "Heavy Aggregate",
    desc: "Heavy-duty aggregate engineered for deep foundations and mass civil works.",
    img: "/images/40mm.jpg"
  },
  {
    name: "20 MM",
    sub: "RCC Aggregate",
    desc: "High load-bearing aggregate for reinforced concrete columns, slabs, and footings.",
    img: "/images/20mm.jpg"
  },
  {
    name: "12 MM",
    sub: "Medium Aggregate",
    desc: "Precision crushed stone for roofing slabs, beams, and precast concrete.",
    img: "/images/12mm.jpg"
  },
  {
    name: "6 MM",
    sub: "Precision Chips",
    desc: "Fine angular stone chips for solid blocks, designer paving, and flooring.",
    img: "/images/6mm.jpg"
  },
  {
    name: "DUST",
    sub: "Quarry Dust",
    desc: "High compaction fine material for stable leveling, filling, and block making.",
    img: "/images/dust.jpg"
  },
  {
    name: "WMM",
    sub: "Wet Mix Macadam",
    desc: "Dense-graded premix aggregate for high-traffic highway base courses.",
    img: "/images/12mm.jpg"
  },
  {
    name: "GSB",
    sub: "Granular Sub-Base",
    desc: "High-strength sub-base material engineered for stable roadbed foundations.",
    img: "/images/40mm.jpg"
  }
];

const sandProducts = products.slice(0, 2);
const aggregateProducts = products.slice(2);
---

<section
  id="products"
  class="scroll-mt-20 md:scroll-mt-0 w-full bg-brandBg overflow-hidden select-none text-gray-900 relative pt-20 pb-12 sm:pt-24 sm:pb-14 md:py-0 md:h-screen md:h-[100dvh] md:flex md:flex-col md:justify-center md:pt-[76px] md:pb-6"
>
  {/* Section Header */}
  <div class="max-w-7xl mx-auto px-6 sm:px-10 md:px-14 lg:px-16 mb-2 md:mb-4 lg:mb-5 w-full flex items-end justify-between shrink-0">
    <div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight uppercase text-gray-950 font-satoshi">
        Our Products
      </h2>
    </div>

    {/* Subtle desktop scroll indicator */}
    <div class="hidden md:flex items-center gap-2 text-xs uppercase tracking-widest text-gray-400 font-satoshi select-none">
      <span>Scroll to explore</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-pulse text-brandBlue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </div>
  </div>

  {/* MOBILE VIEW: Row 1 has M-Sand & P-Sand (2 items in a row), then remaining items in rows of 3 */}
  <div class="md:hidden flex flex-col gap-3 sm:gap-3.5 w-full px-3.5 sm:px-6">
    {/* Row 1: M-Sand & P-Sand in one row */}
    <div class="grid grid-cols-2 gap-2.5 sm:gap-3 w-full">
      {sandProducts.map((product) => (
        <a
          href="#contact"
          class="product-arch-card group relative w-full h-[230px] sm:h-[260px] rounded-full overflow-hidden shadow-[0_12px_30px_-6px_rgba(0,0,0,0.2)] border border-gray-200/80 hover:border-gray-400/80 transition-all duration-300 block"
        >
          {/* Background Image - Eager for immediate mobile display */}
          <img
            src={product.img}
            alt={product.name}
            class="w-full h-full object-cover pointer-events-none"
            loading="eager"
            decoding="async"
          />

          {/* Vignette Gradients */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent pointer-events-none"></div>
          <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/30 to-transparent pointer-events-none"></div>

          {/* Centered Bottom Typography matching reference */}
          <div class="absolute inset-x-0 bottom-0 pb-6 sm:pb-7 px-3 text-center z-20 pointer-events-none">
            <h3 class="text-sm sm:text-base font-black uppercase text-white tracking-wider font-satoshi leading-tight drop-shadow-md">
              {product.name}
            </h3>
            <p class="text-[9px] sm:text-[10px] font-medium text-white/85 tracking-wide mt-1 font-satoshi truncate">
              {product.sub}
            </p>
          </div>
        </a>
      ))}
    </div>

    {/* Subsequent Rows: 3 items in each row */}
    <div class="grid grid-cols-3 gap-2 sm:gap-2.5 w-full">
      {aggregateProducts.map((product, idx) => (
        <a
          href="#contact"
          class={`product-arch-card group relative w-full h-[165px] sm:h-[185px] rounded-full overflow-hidden shadow-[0_10px_24px_-4px_rgba(0,0,0,0.18)] border border-gray-200/80 hover:border-gray-400/80 transition-all duration-300 block ${idx === 6 ? 'col-start-2' : ''}`}
        >
          {/* Background Image */}
          <img
            src={product.img}
            alt={product.name}
            class="w-full h-full object-cover pointer-events-none"
            loading="lazy"
            decoding="async"
          />

          {/* Vignette Gradients */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent pointer-events-none"></div>
          <div class="absolute inset-x-0 top-0 h-14 bg-gradient-to-b from-black/30 to-transparent pointer-events-none"></div>

          {/* Centered Bottom Typography matching reference */}
          <div class="absolute inset-x-0 bottom-0 pb-4 sm:pb-5 px-1.5 text-center z-20 pointer-events-none">
            <h3 class="text-[11px] sm:text-xs font-black uppercase text-white tracking-wider font-satoshi leading-tight drop-shadow-md">
              {product.name}
            </h3>
            <p class="text-[8px] sm:text-[9px] font-semibold text-white/85 tracking-wide mt-0.5 font-satoshi truncate">
              {product.sub}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>

  {/* DESKTOP VIEW: Pin-on-scroll automatic horizontal slider (GPU accelerated, zero lag) */}
  <div class="hidden md:flex flex-col justify-center w-full overflow-hidden relative shrink-0 py-1">
    <div
      id="products-desktop-track"
      class="products-scroll-track flex items-center gap-5 lg:gap-7 flex-nowrap will-change-transform pl-6 lg:pl-16 pr-16 py-1"
    >
      {products.map((product, idx) => (
        <a
          href="#contact"
          class="product-arch-card group relative flex-shrink-0 w-[205px] md:w-[220px] lg:w-[240px] xl:w-[255px] h-[310px] md:h-[340px] lg:h-[370px] xl:h-[390px] max-h-[52vh] rounded-full overflow-hidden shadow-[0_16px_38px_-8px_rgba(0,0,0,0.22)] border border-gray-200/80 hover:border-gray-400/80 transition-all duration-500 hover:-translate-y-2 block"
        >
          {/* Background Image with Zoom on hover - Eager load initial cards to eliminate slide lag */}
          <img
            src={product.img}
            alt={product.name}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 pointer-events-none"
            loading={idx < 5 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={idx < 3 ? "high" : "auto"}
          />

          {/* Vignette Gradients */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent pointer-events-none"></div>
          <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/25 to-transparent pointer-events-none"></div>

          {/* Centered Bottom Typography matching reference image */}
          <div class="absolute inset-x-0 bottom-0 pb-6 lg:pb-8 px-4 text-center z-20 pointer-events-none">
            <h3 class="text-base lg:text-lg font-black uppercase text-white tracking-wider font-satoshi leading-tight drop-shadow-lg group-hover:text-sky-300 transition-colors duration-300">
              {product.name}
            </h3>
            <p class="text-[10px] lg:text-[11px] font-medium text-white/85 tracking-wide mt-1 font-satoshi line-clamp-1">
              {product.sub}
            </p>
          </div>
        </a>
      ))}
    </div>

    {/* Sleek horizontal scroll progress bar matching reference image */}
    <div class="hidden md:flex max-w-7xl mx-auto px-6 sm:px-10 md:px-14 lg:px-16 w-full mt-3 mb-1 items-center justify-between shrink-0">
      <div class="w-full max-w-md h-1 bg-gray-200 rounded-full overflow-hidden relative">
        <div id="products-progress-bar" class="h-full bg-brandBlue rounded-full w-0 will-change-[width] transition-all duration-75"></div>
      </div>
      <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 font-satoshi">
        {products.length} Products
      </span>
    </div>
  </div>
</section>

<style>
  /* Capsule Stadium / Arch geometry with WebKit anti-aliasing */
  .product-arch-card {
    border-radius: 9999px;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    mask-image: radial-gradient(white, black);
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* GPU-accelerated horizontal track */
  .products-scroll-track {
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Preload product images into memory for instantaneous rendering
  const preloadSources = [
    "/images/msand.jpg",
    "/images/psand.jpg",
    "/images/40mm.jpg",
    "/images/20mm.jpg",
    "/images/12mm.jpg",
    "/images/6mm.jpg",
    "/images/dust.jpg"
  ];
  preloadSources.forEach(src => {
    const img = new Image();
    img.src = src;
  });

  const initProductsScroll = () => {
    const section = document.getElementById("products");
    const track = document.getElementById("products-desktop-track");
    const progressBar = document.getElementById("products-progress-bar");
    if (!section || !track) return;

    const mm = gsap.matchMedia();

    // Desktop ONLY (min-width: 768px): automatic horizontal slide while scrolling vertically
    mm.add("(min-width: 768px)", () => {
      const getScrollAmount = () => {
        const trackWidth = track.scrollWidth;
        const windowWidth = window.innerWidth;
        return -(trackWidth - windowWidth + 120);
      };

      const tween = gsap.to(track, {
        x: getScrollAmount,
        ease: "none",
        scrollTrigger: {
          id: "products-trigger",
          trigger: section,
          start: "top top",
          end: () => `+=${Math.abs(getScrollAmount()) * 1.15}`,
          pin: true,
          scrub: 0.6, // Smooth 60fps/120fps GPU interpolation with zero lag
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (progressBar) {
              const progressPct = Math.min(100, Math.max(0, self.progress * 100));
              progressBar.style.width = `${progressPct}%`;
            }
          }
        }
      });

      // Smooth anchor navigation directly to the pinned start position
      document.querySelectorAll('a[href="#products"]').forEach(link => {
        link.addEventListener('click', (e) => {
          if (window.innerWidth >= 768) {
            e.preventDefault();
            const st = ScrollTrigger.getById("products-trigger");
            if (st) {
              window.scrollTo({
                top: st.start,
                behavior: "smooth"
              });
            } else {
              section.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          }
        });
      });

      return () => {
        tween.kill();
      };
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProductsScroll);
  } else {
    initProductsScroll();
  }
</script>