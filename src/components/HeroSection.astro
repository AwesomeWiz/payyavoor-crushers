---
// Unsplash images using the 'quarry' keyword for more appropriate visuals
const images = [
  "/images/award1.jpg",
  "/images/tree.jpg", 
  "/images/office.png",
  "/images/mist.png",
];
---

<section id="hero" class="pt-32 md:pt-48 pb-0 flex flex-col justify-center overflow-hidden min-h-[70vh] md:min-h-screen">
  <div id="hero-text-block" class="px-6 md:px-10 w-full max-w-7xl mx-auto flex flex-col items-center mb-6 md:mb-16 text-center shrink-0">

    <h1 id="hero-real-h1" class="text-[2.1rem] md:text-6xl lg:text-[5rem] leading-[1.35] md:leading-[1.2] text-black" style="font-family: 'Montserrat', sans-serif;">
      Built on <span class="font-bold">Strength.</span><br />
      Driven by <span class="font-bold text-[#1A9487]">Quality.</span>
    </h1>
  </div>

  <div id="hero-copyright" class="text-center mb-12 md:mb-3 shrink-0">
    <p class="font-satoshi text-gray-500 text-sm md:text-base tracking-wide">
      Payyavoor Crushers © Since 1995
    </p>
  </div>

  <div id="hero-carousel" class="w-full relative pb-8 bg-transparent mb-0 overflow-hidden shrink-0">
    <div class="flex animate-carousel w-fit gap-2 px-5">
      {/* Group 1 */}
      {images.map((src) => (
        <div class="h-[350px] md:h-80 w-[280px] md:w-[450px] flex-shrink-0 rounded-2xl overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)]">
          <img src={src} class="w-full h-full object-cover" alt="Quarry image" />
        </div>
      ))}
      {/* Group 2 */}
      {images.map((src) => (
        <div class="h-[350px] md:h-80 w-[280px] md:w-[450px] flex-shrink-0 rounded-2xl overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)]">
          <img src={src} class="w-full h-full object-cover" alt="Quarry image" />
        </div>
      ))}
      {/* Group 3 */}
      {images.map((src) => (
        <div class="h-[350px] md:h-80 w-[280px] md:w-[450px] flex-shrink-0 rounded-2xl overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)]">
          <img src={src} class="w-full h-full object-cover" alt="Quarry image" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes carousel {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.3333333333%); }
  }
  
  .animate-carousel {
    display: flex;
    animation: carousel 60s linear infinite;
  }
</style>
