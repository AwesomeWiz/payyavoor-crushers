---
---

<section id="hero" class="relative w-full overflow-hidden bg-brandBg">
  <!-- Opening Page Hero Image Section (matching reference format) -->
  <div class="relative w-full h-[85vh] md:h-screen min-h-[550px] overflow-hidden">
    <img
      src="/images/mainpic.png"
      alt="Payyavoor Crushers Office & Facility"
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Top dark gradient overlay so navbar logo, buttons, and links are clearly readable -->
    <div class="absolute inset-x-0 top-0 h-52 md:h-72 bg-gradient-to-b from-black/85 via-black/40 to-transparent pointer-events-none"></div>

    <!-- Bottom soft gradient transition -->
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/35 to-transparent pointer-events-none"></div>
  </div>
</section>
