---
---

<section id="hero" class="relative w-full overflow-hidden bg-brandBg">
  <!-- Opening Page Hero Image Section - Fully filling viewport on mobile & desktop -->
  <div class="relative w-full h-screen h-[100dvh] min-h-[100svh] overflow-hidden">
    <img
      src="/images/mainpic.png"
      alt="Payyavoor Crushers Office & Facility"
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Top dark gradient overlay so navbar logo, buttons, and links are clearly readable -->
    <div class="absolute inset-x-0 top-0 h-44 sm:h-56 md:h-72 bg-gradient-to-b from-black/85 via-black/40 to-transparent pointer-events-none"></div>

    <!-- Bottom soft gradient transition -->
    <div class="absolute inset-x-0 bottom-0 h-20 sm:h-28 bg-gradient-to-t from-black/35 to-transparent pointer-events-none"></div>
  </div>
</section>
