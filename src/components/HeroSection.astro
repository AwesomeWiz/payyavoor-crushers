---
// Unsplash images using the 'quarry' keyword for more appropriate visuals
const images = [
  "https://boothventures.co.uk/wp-content/uploads/2023/11/A-to-Z-of-Quarrying.jpg",
  "https://cdn.britannica.com/15/129115-050-09898223/Portland-quarry-Eng-Dorset.jpg", 
  "https://www.azomining.com/images/Article_Images/ImageForArticle_1498(1).jpg",
  "https://media.istockphoto.com/id/519702771/photo/industrial-crusher-rock-stone-crushing-machine.jpg?s=612x612&w=0&k=20&c=XtnewPXY_4WiuJcjMoHHQGxI6dRCr3jGz1W5QWZbtH4=",
];
---

<section id="hero" class="pt-32 md:pt-48 pb-0 flex flex-col justify-center overflow-hidden min-h-[70vh] md:min-h-screen">
  <div id="hero-text-block" class="px-6 md:px-10 w-full max-w-7xl mx-auto flex flex-col items-center mb-16 text-center">
    <p id="hero-subtitle" class="font-satoshi font-medium text-lg md:text-xl text-gray-800 tracking-wide mb-6">
      Granite mining and aggregate supply
    </p>
    <h1 id="hero-real-h1" class="font-serif text-5xl md:text-8xl leading-[1.1] md:leading-[1.1] text-black">
      Building the <span class="italic font-light">foundation</span><br />
      for — tomorrow
    </h1>
  </div>

  <div id="hero-copyright" class="text-center mb-2 md:mb-3">
    <p class="font-satoshi text-gray-500 text-sm md:text-base tracking-wide">
      Payyavoor Crushers © Since 1995
    </p>
  </div>

  <div id="hero-carousel" class="w-full relative pb-8 bg-transparent mb-0 overflow-hidden">
    <div class="flex animate-carousel w-fit gap-2 px-5">
      {/* Group 1 */}
      {images.map((src) => (
        <div class="h-64 md:h-80 w-80 md:w-[450px] flex-shrink-0 rounded-2xl overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)]">
          <img src={src} class="w-full h-full object-cover" alt="Quarry image" />
        </div>
      ))}
      {/* Group 2 */}
      {images.map((src) => (
        <div class="h-64 md:h-80 w-80 md:w-[450px] flex-shrink-0 rounded-2xl overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)]">
          <img src={src} class="w-full h-full object-cover" alt="Quarry image" />
        </div>
      ))}
      {/* Group 3 */}
      {images.map((src) => (
        <div class="h-64 md:h-80 w-80 md:w-[450px] flex-shrink-0 rounded-2xl overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)]">
          <img src={src} class="w-full h-full object-cover" alt="Quarry image" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes carousel {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.3333333333%); }
  }
  
  .animate-carousel {
    display: flex;
    animation: carousel 60s linear infinite;
  }
</style>
