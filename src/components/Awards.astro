---
const awards = [
  { year: "2026", title: "Govt Award", image: "/images/award1.jpg", text: "Recognized for outstanding contribution to regional infrastructure development." },
  { year: "2018", title: "State Award for Environmental Practice", image: "/images/award1.jpg", text: "3rd Prize in Best Environmental Practice, handed over by former CM Pinarayi Vijayan." },
  { year: "2014", title: "Top 3 in Pollution Control", image: "/images/c3.jpeg", text: "Secured 3rd place statewide for sustained pollution control in the Crusher category." },
  { year: "2013", title: "Eco-Initiatives Award", image: "/images/c1.jpeg", text: "Awarded by the Kerala State Pollution Control Board for environmental responsibility." },
];

const displayAwards = [...awards, ...awards]; // Replicate to make 8 items for a full cylinder
---

<section id="awards-legacy" class="min-h-screen w-full flex flex-col justify-center px-6 md:px-12 relative overflow-hidden bg-white select-none">
  
  <!-- Header -->
  <div class="max-w-7xl mx-auto w-full mb-6 md:mb-8 text-center">
    <span class="inline-block text-[11px] md:text-xs font-bold text-brandBlue tracking-[0.25em] uppercase mb-2 font-satoshi">
      OUR RECOGNITIONS
    </span>
    <h3 class="text-3xl md:text-5xl font-semibold text-gray-900 tracking-tight" style="font-family: 'Montserrat', sans-serif;">
      Awards
    </h3>
  </div>

  <!-- Viewport for 3D Perspective -->
  <div class="carousel-viewport w-full flex items-center justify-center py-2 overflow-visible relative">
    <!-- Tilt Wrapper (Applying the side Y-tilt to show 3D depth) -->
    <div class="carousel-tilt">
      <!-- Cylinder Track -->
      <div id="awards-cylinder-track" class="carousel-container">
        {displayAwards.map((award, index) => {
          return (
            <div class="carousel-card group">
              <!-- Premium Opaque Glassmorphic Card -->
              <div class="w-full h-full border border-white/10 bg-[#0f0f11] rounded-[24px] p-5 flex flex-col justify-between shadow-2xl relative overflow-hidden">
                <!-- Glossy sheen reflection overlay -->
                <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/[0.015] to-white/[0.06] pointer-events-none z-10"></div>
                
                <div class="relative z-20">
                  <!-- Card Header -->
                  <div class="flex justify-between items-start">
                    <span class="text-2xl md:text-3xl font-bold text-white font-satoshi tracking-tight leading-none">
                      {award.year}
                    </span>
                    <span class="text-[9px] uppercase tracking-widest text-sky-400 font-semibold px-2 py-0.5 rounded-full bg-white/5 border border-white/10">
                      Legacy
                    </span>
                  </div>
                  
                  <!-- Award Title -->
                  <h4 class="text-base md:text-lg font-semibold text-white/95 mt-3 tracking-tight leading-snug">
                    {award.title}
                  </h4>

                  <!-- Divider line -->
                  <div class="w-full h-px bg-white/10 my-2.5"></div>

                  <!-- Award Description -->
                  <p class="text-[11px] md:text-[12px] text-white/60 font-satoshi leading-relaxed">
                    {award.text}
                  </p>
                </div>

                <!-- Award Image -->
                <div class="w-full h-20 md:h-24 rounded-xl overflow-hidden relative shadow-inner mt-3 z-20">
                  <img 
                    src={award.image} 
                    alt={award.title} 
                    class="w-full h-full object-cover pointer-events-none" 
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0f0f11]/60 to-transparent"></div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Scroll Indicator Hint -->
  <div class="w-full flex justify-center mt-6 text-gray-400 font-satoshi text-xs tracking-widest uppercase items-center gap-2 select-none opacity-60">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 13l-7 7-7-7m14-6l-7 7-7-7" />
    </svg>
    Scroll to explore awards
  </div>

</section>

<style>
  .carousel-viewport {
    perspective: 1400px;
    height: 460px;
  }

  .carousel-tilt {
    transform-style: preserve-3d;
    transform: rotateY(-12deg);
    will-change: transform;
  }

  .carousel-container {
    width: 230px;
    height: 300px;
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(0deg);
    will-change: transform;
  }

  .carousel-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backface-visibility: visible;
    will-change: transform, filter, opacity;
    
    /* Default non-center cards: Black & White (Grayscale) + Faded opacity */
    filter: grayscale(100%);
    opacity: 0.35;
    
    /* Smooth transitions for center highlights */
    transition: filter 0.6s cubic-bezier(0.25, 1, 0.5, 1), 
                opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Center card: Full color + opaque */
  .carousel-card.is-center {
    filter: grayscale(0%);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .carousel-viewport {
      height: 360px;
    }
    .carousel-tilt {
      transform: rotateY(-8deg);
    }
    .carousel-container {
      width: 180px;
      height: 245px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    const track = document.getElementById("awards-cylinder-track");
    if (!track) return;

    const cards = track.querySelectorAll(".carousel-card");
    const numCards = cards.length;

    // Compact radius to keep the orbit well within the screen boundaries
    let R = window.innerWidth < 640 ? 110 : 160;

    // Function to calculate and apply 3D positions of the Ferris Wheel
    const updateFerrisWheel = (rotationX) => {
      cards.forEach((card, index) => {
        const cardAngle = index * (360 / numCards);
        const counterAngle = -(cardAngle + rotationX);
        
        // Position on vertical wheel and keep card upright facing the camera
        card.style.transform = `rotateX(${cardAngle}deg) translateZ(${R}px) rotateX(${counterAngle}deg)`;

        // Highlight center card (closest to front)
        const centerIndex = (Math.round(-rotationX / (360 / numCards)) % numCards + numCards) % numCards;
        if (index === centerIndex) {
          card.classList.add("is-center");
        } else {
          card.classList.remove("is-center");
        }
      });
    };

    // Initial position
    updateFerrisWheel(0);

    // Dynamic radius adjustment on resize
    window.addEventListener("resize", () => {
      R = window.innerWidth < 640 ? 110 : 160;
      const currentRX = gsap.getProperty(track, "rotateX") as number || 0;
      updateFerrisWheel(currentRX);
    });

    // Spin the Ferris Wheel vertically as the user scrolls (pinned in place)
    gsap.fromTo(track, 
      { rotateX: 0 },
      {
        rotateX: -360, // Rotate 360 degrees (one full round)
        ease: "none",
        scrollTrigger: {
          trigger: "#awards-legacy",
          start: "top top",   // Pin when the section fills the viewport
          end: "+=1300",      // Pin duration (length of scroll space)
          pin: true,          // Pin the section
          scrub: 1.2,         // Smooth lag for rotation
          onUpdate: (self) => {
            const rX = gsap.getProperty(track, "rotateX") as number;
            updateFerrisWheel(rX);
          }
        }
      }
    );
  });
</script>
