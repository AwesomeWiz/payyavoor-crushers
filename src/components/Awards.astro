---
const awards = [
  {
    id: "2018",
    year: "2018",
    statSub: "3RD PRIZE STATEWIDE",
    title: "Best Environmental Practice",
    category: "Kerala State Award",
    desc: "Conferred by former Chief Minister Pinarayi Vijayan & the Kerala State Pollution Control Board for exemplary eco-friendly operations.",
    image: "/images/award1.jpg",
    collapsedTag: "2018 State Award",
    badge: "Kerala State Award"
  },
  {
    id: "2014",
    year: "2014",
    statSub: "TOP 3 IN KERALA",
    title: "Sustained Pollution Control",
    category: "Kerala State Award",
    desc: "Honored statewide by the Kerala State Pollution Control Board for continuous emission mitigation and environmental management.",
    image: "/images/c3.jpeg",
    collapsedTag: "2014 State Award",
    badge: "Kerala State Award"
  },
  {
    id: "2013",
    year: "2013",
    statSub: "STATE RECOGNITION",
    title: "Eco-Initiatives Award",
    category: "Kerala State Award",
    desc: "Recognized by the Kerala State Pollution Control Board for pioneering sustainable aggregate harvesting and environmental protection.",
    image: "/images/c1.jpeg",
    collapsedTag: "2013 State Award",
    badge: "Kerala State Award"
  },
  {
    id: "more",
    year: "",
    statSub: "",
    title: "And Many More...",
    category: "Kerala State Honors",
    desc: "A continuous legacy of Kerala State Pollution Control Board accolades, environmental citations, and industry recognitions.",
    image: "/images/alltrophy1.jpeg",
    collapsedTag: "& Many More",
    badge: "Kerala State Honors"
  }
];
---

<section
  id="sustainability"
  class="scroll-mt-24 md:scroll-mt-28 w-full min-h-screen py-16 md:py-24 px-4 sm:px-8 md:px-12 lg:px-16 bg-white overflow-hidden select-none flex flex-col justify-center"
>
  <div class="max-w-7xl w-full mx-auto flex flex-col md:flex-row items-center md:items-stretch gap-6 md:gap-8 lg:gap-12">
    
    {/* 90-Degree Rotated Headline (Desktop) */}
    <div
      class="hidden md:flex flex-col items-center justify-center shrink-0 pr-4 lg:pr-8 select-none"
      style="writing-mode: vertical-rl; transform: rotate(180deg);"
    >
      <h2 class="text-6xl lg:text-7xl xl:text-8xl font-black tracking-widest uppercase text-gray-900 font-satoshi leading-none">
        AWARDS
      </h2>
    </div>

    {/* Mobile Compact Header (Mobile only) */}
    <div class="md:hidden w-full text-center mb-2">
      <h2 class="text-3xl sm:text-4xl font-black tracking-wider uppercase text-gray-900 font-satoshi">
        AWARDS
      </h2>
    </div>

    {/* Expanding Cards Container */}
    <div class="w-full flex-1 flex items-center min-w-0">
      <div
        id="awards-accordion-container"
        class="w-full h-[460px] sm:h-[500px] lg:h-[540px] flex gap-2.5 sm:gap-3.5 lg:gap-4 overflow-hidden py-1"
      >
        {awards.map((award, index) => (
          <div
            class={`award-card relative h-full rounded-2xl sm:rounded-3xl lg:rounded-[28px] overflow-hidden cursor-pointer shadow-lg transition-all duration-700 ease-out flex-shrink-0 ${index === 0 ? 'is-active' : ''}`}
            data-index={index}
            role="button"
            tabindex="0"
            aria-label={award.title}
          >
            {/* Background Image */}
            <img
              src={award.image}
              alt={award.title}
              class="award-card-img absolute inset-0 w-full h-full object-cover transition-transform duration-700 pointer-events-none"
              loading="lazy"
            />

            {/* Gradient Overlays */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/25 z-10 pointer-events-none transition-opacity duration-500"></div>
            
            {/* Additional shadow wash for non-active cards */}
            <div class="award-card-dim absolute inset-0 bg-black/40 z-10 pointer-events-none transition-opacity duration-500"></div>

            {/* 1. COLLAPSED STATE: Vertical Badge near bottom */}
            <div class="card-collapsed-label absolute inset-x-0 bottom-6 sm:bottom-8 flex justify-center z-20 pointer-events-none transition-all duration-400">
              <div class="bg-[#0f172a]/90 backdrop-blur-md text-white font-satoshi font-semibold text-[11px] sm:text-xs tracking-wider uppercase px-2.5 py-4 rounded-xl shadow-xl border border-white/15 [writing-mode:vertical-rl] rotate-180 whitespace-nowrap">
                {award.collapsedTag}
              </div>
            </div>

            {/* 2. EXPANDED STATE: Full award details & large stats */}
            <div class="card-expanded-content absolute inset-0 p-6 sm:p-8 lg:p-10 flex flex-col justify-between z-20 text-white pointer-events-none transition-opacity duration-500">
              
              {/* Top Tag */}
              <div class="flex justify-between items-start">
                <span class="inline-block bg-emerald-600/90 backdrop-blur-md text-white border border-emerald-400/30 px-3.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider font-satoshi shadow-md">
                  {award.badge}
                </span>
              </div>

              {/* Bottom Content Bar: Title on left, Big stat on right */}
              <div class="flex items-end justify-between gap-4 mt-auto">
                <div class={award.year ? "max-w-[72%]" : "max-w-full"}>
                  <span class="block text-[11px] sm:text-xs font-semibold text-emerald-400 uppercase tracking-widest mb-1.5 font-satoshi">
                    {award.category}
                  </span>
                  <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight leading-snug font-satoshi text-white drop-shadow-md">
                    {award.title}
                  </h3>
                  <p class="hidden sm:block text-xs sm:text-sm text-white/85 font-satoshi mt-2 line-clamp-2 leading-relaxed">
                    {award.desc}
                  </p>
                </div>

                {/* Big Stat / Year Badge */}
                {award.year ? (
                  <div class="text-right shrink-0">
                    <span class="text-3xl sm:text-4xl lg:text-5xl font-black font-satoshi tracking-tight text-white block leading-none drop-shadow-lg">
                      {award.year}
                    </span>
                    {award.statSub ? (
                      <span class="text-[9px] sm:text-[10px] font-bold text-white/70 tracking-widest uppercase mt-1 block font-satoshi">
                        {award.statSub}
                      </span>
                    ) : null}
                  </div>
                ) : null}
              </div>

            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* Base flex values for smooth responsive accordion */
  .award-card {
    flex: 1;
    min-width: 58px;
  }

  /* Active card expands significantly */
  .award-card.is-active {
    flex: 3.8;
    min-width: 240px;
  }

  /* Image zoom on active */
  .award-card.is-active .award-card-img {
    transform: scale(1.05);
  }

  /* Dim non-active cards */
  .award-card:not(.is-active) .award-card-dim {
    opacity: 0.6;
  }
  .award-card.is-active .award-card-dim {
    opacity: 0;
  }

  /* Hide/show collapsed vs expanded states */
  .award-card.is-active .card-collapsed-label {
    opacity: 0;
    transform: translateY(12px);
  }
  .award-card:not(.is-active) .card-collapsed-label {
    opacity: 1;
    transform: translateY(0);
  }

  .award-card.is-active .card-expanded-content {
    opacity: 1;
    pointer-events: auto;
  }
  .award-card:not(.is-active) .card-expanded-content {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .award-card {
      min-width: 48px;
    }
    .award-card.is-active {
      min-width: 200px;
      flex: 3.2;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("sustainability");
    const container = document.getElementById("awards-accordion-container");
    if (!section || !container) return;

    const cards = Array.from(container.querySelectorAll<HTMLElement>(".award-card"));
    const totalCards = cards.length;
    let activeIndex = 0;

    const setActiveCard = (index: number) => {
      if (index === activeIndex && cards[index].classList.contains("is-active")) return;
      activeIndex = index;
      cards.forEach((card, i) => {
        if (i === index) {
          card.classList.add("is-active");
        } else {
          card.classList.remove("is-active");
        }
      });
    };

    // ScrollTrigger to smoothly open each card in sequence as user scrolls
    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: () => (window.innerWidth < 768 ? "+=1200" : "+=1800"),
      pin: true,
      scrub: 0.4,
      onUpdate: (self) => {
        const p = Math.max(0, Math.min(0.999, self.progress));
        const targetIndex = Math.floor(p * totalCards);
        setActiveCard(targetIndex);
      }
    });

    // Also allow direct hover or click interaction
    cards.forEach((card, i) => {
      card.addEventListener("mouseenter", () => {
        setActiveCard(i);
      });
      card.addEventListener("click", () => {
        setActiveCard(i);
      });
    });
  });
</script>
