---
interface Props {
  bgImage?: string;
  bgImageClass?: string;
}

const {
  bgImage,
  bgImageClass = "absolute right-4 bottom-0 w-32 md:w-44 h-auto opacity-[0.06] pointer-events-none z-0 mix-blend-multiply"
} = Astro.props;

const projects = [
  {
    name: "Kannur Intl. Airport",
    image: "/images/airportknr.png"
  },
  {
    name: "Indian Naval Academy",
    image: "/images/ezhimala.png"
  },
  {
    name: "Thalassery–Mahe NH 66",
    image: "/images/maheby.png"
  },
  {
    name: "KIMS Sreechand Hospital",
    image: "/images/sree.png"
  },
  {
    name: "NIFT",
    image: "/images/nift.png"
  },
  {
    name: "And Many More Landmark Projects Across Kannur",
    isLast: true,
    image: "/images/office.jpeg"
  }
];

// Replicate for seamless infinite marquee loop (3 full sets)
const marqueeItems = [...projects, ...projects, ...projects];
---

<section id="projects" class="scroll-mt-24 md:scroll-mt-28 w-full relative pt-12 sm:pt-16 md:pt-20 pb-12 sm:pb-16 md:pb-24 bg-gradient-to-b from-brandBg via-white/40 to-brandBg overflow-hidden">
  <!-- Top and Bottom vertical fades for smooth page transition -->
  <div class="absolute top-0 left-0 right-0 h-14 bg-gradient-to-b from-brandBg to-transparent z-10 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 right-0 h-14 bg-gradient-to-t from-brandBg to-transparent z-10 pointer-events-none"></div>

  {bgImage && (
    <img src={bgImage} alt="" class={bgImageClass} aria-hidden="true" />
  )}

  <!-- Section Header (Centered, No Descriptions) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 text-center mb-8 sm:mb-10 md:mb-14 relative z-20">
    <span class="inline-block text-[11px] md:text-xs font-bold text-brandBlue tracking-[0.25em] uppercase mb-2 font-satoshi">
      KEY PROJECTS
    </span>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-gray-900 tracking-tight font-satoshi leading-tight">
      Where Our Materials Make a Difference
    </h2>
  </div>

  <!-- Scrolling Track Area with Subtle Edge Feather -->
  <div class="relative w-full overflow-hidden select-none marquee-mask">
    
    <!-- Slim, subtle edge blur (small slight blur without milky white overlay) -->
    <div class="absolute left-0 top-0 bottom-0 w-4 sm:w-6 md:w-8 bg-gradient-to-r from-brandBg/40 to-transparent z-10 pointer-events-none backdrop-blur-[2px]"></div>
    <div class="absolute right-0 top-0 bottom-0 w-4 sm:w-6 md:w-8 bg-gradient-to-l from-brandBg/40 to-transparent z-10 pointer-events-none backdrop-blur-[2px]"></div>

    <!-- Infinite Scrolling Track -->
    <div class="flex gap-4 sm:gap-5 md:gap-6 w-max animate-projects-marquee py-3 px-4">
      {marqueeItems.map((p, idx) => (
        p.isLast ? (
          <!-- & Many More... Card -->
          <a 
            href="#contact" 
            class="group relative h-[280px] sm:h-[340px] md:h-[400px] lg:h-[450px] w-[200px] sm:w-[240px] md:w-[280px] lg:w-[310px] rounded-xl sm:rounded-2xl overflow-hidden border border-[#071F30] bg-[#071F30] shadow-md hover:shadow-xl hover:border-sky-400/60 transition-all duration-300 flex flex-col items-center justify-center p-4 text-center shrink-0 block"
          >
            <!-- Content -->
            <div class="h-full w-full flex flex-col items-center justify-center px-4 sm:px-6 text-center">
              <span class="text-sm sm:text-base md:text-lg lg:text-xl font-bold text-white font-satoshi leading-snug tracking-tight">
                And Many More Landmark Projects Across Kannur
              </span>
            </div>
          </a>
        ) : (
          <!-- Landmark Project Card -->
          <div class="group relative h-[280px] sm:h-[340px] md:h-[400px] lg:h-[450px] w-[200px] sm:w-[240px] md:w-[280px] lg:w-[310px] rounded-xl sm:rounded-2xl overflow-hidden border border-gray-200/90 bg-gray-950 shadow-md hover:shadow-2xl transition-all duration-300 shrink-0">
            <!-- Portrait Image -->
            <img 
              src={p.image} 
              alt={p.name} 
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 pointer-events-none" 
              loading={idx < 6 ? "eager" : "lazy"} 
              decoding="async" 
            />

            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent pointer-events-none"></div>

            <!-- Bottom Title Only (No Description) -->
            <div class="absolute bottom-0 inset-x-0 p-3.5 sm:p-4 lg:p-5 text-center z-10 pointer-events-none">
              <span class="block text-xs sm:text-sm lg:text-base font-bold text-white font-satoshi leading-snug drop-shadow-md">
                {p.name}
              </span>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes projectsMarquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-33.3333333333%, 0, 0);
    }
  }

  .animate-projects-marquee {
    display: flex;
    animation: projectsMarquee 40s linear infinite;
    will-change: transform;
    transform: translateZ(0);
    pointer-events: auto;
  }

  .marquee-mask {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 20px, black calc(100% - 20px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 20px, black calc(100% - 20px), transparent 100%);
  }
</style>
